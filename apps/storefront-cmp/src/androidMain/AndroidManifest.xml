<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Package visibility (API 30+). Without this, `resolveActivity` for a CUSTOM scheme returns
         null for every app this one cannot already see — the automatic-visibility carve-out covers
         http/https web intents, not `azphalt://`. `network/AndroidHandoff.kt` asks before launching,
         so without this declaration the answer is always "no host installed" and the user is shown
         the fallback sheet while a conforming host sits on the device.

         Deliberately an <intent> filter rather than a <package> name: naming hosts here would be the
         same privileging the scheme exists to avoid (spec/web-handoff.md § Why a custom scheme). This
         asks "who claims azphalt://", which is exactly the question, and nothing more. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="azphalt" />
        </intent>
    </queries>
    <!-- Play Billing. Required for the paid lane (spec/store-app.md § Paid packages). -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Firebase Analytics ships with advertising permissions this app has no use for.
         `firebase-analytics` merges in the advertising ID and the Privacy Sandbox ad-attribution
         permissions by default, because most apps that measure also advertise. This one does not:
         the published privacy policy states there is no advertising identifier and no advertising
         partner, and a permission in the manifest is a fact about the app regardless of whether any
         code reads it — Play's Data Safety form is answered from what is declared here.

         Removed rather than merely unused, so the claim holds at the manifest level. Analytics keeps
         working; what stops working is ad attribution, which was never wanted. The meta-data flags
         below turn off the same collection inside the SDK, so this does not depend on the merger
         alone. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <application
        android:label="Azphalt"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Azphalt"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- Firebase Analytics collection settings.
             The advertising ID and the Android ID (SSAID) are both device-scoped identifiers that
             would survive a reinstall and could be joined against other apps' data. Analytics does
             not need either to count screen views and installs, which is all this app measures, so
             it is left with only the app-instance id — a random value scoped to this install and
             cleared when the app is uninstalled or its data wiped. -->
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
        <meta-data android:name="google_analytics_ssaid_collection_enabled" android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />

        <!-- The store, opened by a person. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Azphalt"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The link form from spec/store-app.md: opens the store, returns nothing. For contexts
                 that cannot start an activity for result — a web page, a notification. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="azphalt" android:host="browse" />
            </intent-filter>
        </activity>

        <!-- The store, opened by another app to acquire something on its behalf.
             Separate from MainActivity on purpose: this one always finishes with a result, and
             `excludeFromRecents` + `noHistory` keep a host's acquisition trip out of the user's
             recents as a stray "Azphalt" task after they have returned to the host app. -->
        <activity
            android:name=".BrowseForResultActivity"
            android:exported="true"
            android:label="Add an extension"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="store.azphalt.action.BROWSE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Serves the verified .azp back to the calling app. A FileProvider rather than a file:// URI
             because the host is a different process: the grant is per-URI, per-caller, and revocable,
             which is what makes handing over bytes safe. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.packages"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
