{
  "name": "@azphalt/storefront-react",
  "private": true,
  "version": "0.1.3",
  "description": "A React PWA storefront on the azphalt Repository API — a framework-agnostic sibling to the Compose (Kotlin/Wasm) storefront.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/export-catalog.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@azphalt/azp": "workspace:*",
    "@azphalt/web-handoff": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
