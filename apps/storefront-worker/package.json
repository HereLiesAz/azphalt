{
  "name": "@azphalt/storefront-worker",
  "private": true,
  "version": "0.1.0",
  "description": "The production azphalt.store / azphalt.org backend: a Cloudflare Worker serving the React storefront, the docs, and the Repository API over a SQLite Durable Object.",
  "type": "module",
  "scripts": {
    "build": "node scripts/assemble-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@azphalt/azp": "workspace:*",
    "@azphalt/docs": "workspace:*",
    "@azphalt/storefront-react": "workspace:*",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  }
}
