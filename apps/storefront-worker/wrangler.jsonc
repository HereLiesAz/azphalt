{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "azphalt",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  // No `routes` here: azphalt.store, www.azphalt.store, azphalt.org and www.azphalt.org are attached to
  // this Worker as Custom Domains in the Cloudflare dashboard (README § Domains). Declaring them here
  // would make every deploy fail until those zones are on the account.
  "assets": {
    // Built by `pnpm --filter "@azphalt/storefront-worker..." build`: the React storefront at the root,
    // the docs under /_docs (scripts/assemble-assets.mjs).
    "directory": "./dist",
    "binding": "ASSETS",
    // A miss is a plain 404; the Worker decides what a miss means per host (the storefront's SPA shell
    // on azphalt.store, the docs' 404 page on azphalt.org).
    "not_found_handling": "none",
    // Everything runs through the Worker except the storefront's hashed bundles, which are served
    // straight from the edge. The docs keep theirs in /docs-assets/ so azphalt.org still reaches the
    // Worker for them (docs/.vitepress/config.mjs § assetsDir).
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "STATE", "class_name": "AzphaltState" }
    ]
  },
  // Per-IP limit on the public writes (ratings, reports): 10 a minute. Counted by Cloudflare, so the
  // Worker never stores an address. `namespace_id` only has to be unique within the account.
  "ratelimits": [
    { "name": "WRITE_LIMITER", "namespace_id": "4271", "simple": { "limit": 10, "period": 60 } },
    // POST /packages: each accepted publish opens a pull request, so 3 a minute per IP.
    { "name": "PUBLISH_LIMITER", "namespace_id": "4272", "simple": { "limit": 3, "period": 60 } }
  ],
  // POST /packages gets a short-lived GitHub token, narrowed to HereLiesAz/azphalt, from the central
  // gateway Worker (HereLiesAz/workflows worker/src/index.js § RepositoryTokens). A service binding is
  // private to this account, so the minter is not reachable from the internet, and no GitHub secret
  // is stored here.
  "services": [
    { "binding": "GITHUB_TOKENS", "service": "workflows", "entrypoint": "RepositoryTokens" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AzphaltState"] }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://azphalt.store",
    "GITHUB_RAW_BASE": "https://raw.githubusercontent.com/HereLiesAz/azphalt/main/apps/storefront/registry",
    "PLATFORM_FEE_BPS": "1500",
    "PROCESSOR_PCT_BPS": "290",
    "PROCESSOR_FLAT_CENTS": "30",
    // Where POST /packages opens its review pull requests (token: the GITHUB_TOKENS binding above).
    "PUBLISH_REPOSITORY": "HereLiesAz/azphalt",
    // The store app's Play application id (apps/storefront-cmp/build.gradle.kts § applicationId).
    // POST /entitlements/play stays 501 until the PLAY_SERVICE_ACCOUNT_JSON secret is set too.
    "PLAY_PACKAGE_NAME": "com.hereliesaz.azphalt.store",
    // Public half of the key build-catalog signs catalog packages with (AZPHALT_PACKAGE_SIGNING_KEY),
    // listed in /.well-known/azphalt.json so hosts trust those packages. Public, so not a secret;
    // rotate it together with that key.
    "PACKAGE_SIGNING_PUBLIC_KEY_SPKI_B64": "MCowBQYDK2VwAyEAWNptGhJCdyjabJ/pEnw+nh41woxC01z6mS8XnL8Cv+M="
  },
  // Workers Builds runs `wrangler preview` for every non-production branch, and a Preview takes its
  // bindings and vars from this block only (nothing top-level is inherited but assets, migrations
  // and compatibility settings). Without it every pull request's build failed. A Preview gets its
  // own STATE namespace and its own rate-limit counters. It gets no GITHUB_TOKENS binding, so a
  // branch Preview can never open publish pull requests (POST /packages answers 501 there).
  "previews": {
    "durable_objects": {
      "bindings": [
        { "name": "STATE", "class_name": "AzphaltState" }
      ]
    },
    "ratelimits": [
      { "name": "WRITE_LIMITER", "namespace_id": "4273", "simple": { "limit": 10, "period": 60 } },
      { "name": "PUBLISH_LIMITER", "namespace_id": "4274", "simple": { "limit": 3, "period": 60 } }
    ],
    "vars": {
      "PUBLIC_ORIGIN": "https://azphalt.store",
      "GITHUB_RAW_BASE": "https://raw.githubusercontent.com/HereLiesAz/azphalt/main/apps/storefront/registry",
      "PLATFORM_FEE_BPS": "1500",
      "PROCESSOR_PCT_BPS": "290",
      "PROCESSOR_FLAT_CENTS": "30",
      "PLAY_PACKAGE_NAME": "com.hereliesaz.azphalt.store",
      "PACKAGE_SIGNING_PUBLIC_KEY_SPKI_B64": "MCowBQYDK2VwAyEAWNptGhJCdyjabJ/pEnw+nh41woxC01z6mS8XnL8Cv+M="
    }
  }
}
