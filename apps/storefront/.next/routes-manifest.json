{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/.well-known/azphalt-repository.json",
        "destination": "/api/repository/.well-known/azphalt-repository.json",
        "regex": "^/\\.well-known/azphalt-repository\\.json(?:/)?$"
      },
      {
        "source": "/packages",
        "destination": "/api/repository/packages",
        "regex": "^/packages(?:/)?$"
      },
      {
        "source": "/packages/:path*",
        "destination": "/api/repository/packages/:path*",
        "regex": "^/packages(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/revocations",
        "destination": "/api/repository/revocations",
        "regex": "^/revocations(?:/)?$"
      },
      {
        "source": "/updates",
        "destination": "/api/repository/updates",
        "regex": "^/updates(?:/)?$"
      }
    ],
    "afterFiles": [],
    "fallback": [
      {
        "source": "/:path*",
        "destination": "/index.html",
        "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ]
  },
  "dynamicRoutes": [
    {
      "page": "/api/checkout/session/[id]",
      "regex": "^/api/checkout/session/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/checkout/session/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/download/[id]",
      "regex": "^/api/download/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/download/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/preview/[id]",
      "regex": "^/api/preview/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/preview/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/repository/[[...slug]]",
      "regex": "^/api/repository(?:/(.+?))?(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/repository(?:/(?<nxtPslug>.+?))?(?:/)?$"
    },
    {
      "page": "/app/[appId]",
      "regex": "^/app/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPappId": "nxtPappId"
      },
      "namedRegex": "^/app/(?<nxtPappId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/previews/[name]",
      "regex": "^/previews/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPname": "nxtPname"
      },
      "namedRegex": "^/previews/(?<nxtPname>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/checkout/success",
      "regex": "^/checkout/success(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout/success(?:/)?$"
    },
    {
      "page": "/connect/onboard",
      "regex": "^/connect/onboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/connect/onboard(?:/)?$"
    },
    {
      "page": "/moderation",
      "regex": "^/moderation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/moderation(?:/)?$"
    },
    {
      "page": "/privacy",
      "regex": "^/privacy(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/privacy(?:/)?$"
    },
    {
      "page": "/publish",
      "regex": "^/publish(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/publish(?:/)?$"
    },
    {
      "page": "/purchases",
      "regex": "^/purchases(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/purchases(?:/)?$"
    },
    {
      "page": "/report",
      "regex": "^/report(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/report(?:/)?$"
    },
    {
      "page": "/terms",
      "regex": "^/terms(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/terms(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}