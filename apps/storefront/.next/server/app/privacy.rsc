",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","forbidden":"$undefined","unauthorized":"$undefined"}]]}],{"children":["__PAGE__",["$","$1","c",{"children":[["$","main",null,{"className":"legal_page__U9PRk","children":[["$","h1",null,{"children":"Privacy Policy"}],["$","p",null,{"className":"legal_updated__lrgMI","children":["Last updated ","30 July 2026"]}],["$","div",null,{"className":"legal_callout__zqd_h","children":["$","p",null,{"children":[["$","strong",null,{"children":"Azphalt has no user accounts and sets no cookies."}]," You can browse the store and download free extensions without identifying yourself in any way. The website runs no analytics at all; the Android app includes Firebase Analytics, which is described"," ",["$","a",null,{"href":"#app-analytics","children":"below"}],"."]}]}],["$","p",null,{"children":["This policy covers the Azphalt store at ",["$","code",null,{"children":"azphalt.store"}],", the documentation site at"," ",["$","code",null,{"children":"azphalt.org"}],", and the Azphalt Android app. It explains what is collected, what is deliberately not collected, and which third parties are involved when you pay for something."]}],["$","h2",null,{"children":"What we do not collect"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"No cookies."}]," The store and its API set no cookies at all — not for sessions, not for preferences, not for tracking."]}],["$","li",null,{"children":[["$","strong",null,{"children":"No analytics on the website."}]," There is no analytics SDK, tag manager, tracking pixel or session recorder on ",["$","code",null,{"children":"azphalt.store"}],". The Android app is different and is described ",["$","a",null,{"href":"#app-analytics","children":"below"}],"."]}],["$","li",null,{"children":[["$","strong",null,{"children":"No advertising identifier."}]," Neither the site nor the app reads your device advertising ID or Android ID. The app removes the advertising permissions that Firebase would otherwise add, and switches that collection off in the SDK as well."]}],["$","li",null,{"children":[["$","strong",null,{"children":"No advertising."}]," Azphalt shows no ads, has no advertising partners, and does not share anything for ad targeting or measurement."]}],["$","li",null,{"children":[["$","strong",null,{"children":"No accounts."}]," There is nothing to sign up for. Browsing, searching and downloading free extensions require no identity."]}],"$L4","$L5"]}],"$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37"]}],["$L38"],"$L39"]}],{},null,false]},null,false]},null,false],"$L3a",false]],"m":"$undefined","G":["$3b",[]],"s":false,"S":true}
