4:["$","li",null,{"children":[["$","strong",null,{"children":"No browser storage."}]," The store does not write to ",["$","code",null,{"children":"localStorage"}]," or"," ",["$","code",null,{"children":"sessionStorage"}],"."]}]
5:["$","li",null,{"children":[["$","strong",null,{"children":"No access to your work."}]," Azphalt never receives the images, video, audio or projects you use extensions on. Extensions run inside your own app, on your own device."]}]
6:["$","h2",null,{"children":"What is collected"}]
7:["$","h3",null,{"children":"Server logs"}]
8:["$","p",null,{"children":"The store is hosted on Vercel, which keeps standard web-server logs of requests — including IP address, timestamp, requested URL and user-agent. These are operational records used to keep the service running and to investigate abuse. They are not linked to an identity, because there is no identity to link them to."}]
9:["$","h3",null,{"children":"Ratings, reports and download counts"}]
a:["$","p",null,{"children":["If you rate a package or file an abuse report, that submission is recorded against the"," ",["$","em",null,{"children":"package"}],", not against you — no identifier of the submitter is stored. Download tallies are aggregate counters."]}]
b:["$","p",null,{"children":"These live in the running server’s memory and are reset whenever the store is redeployed. They are not written to a database and are not backed up."}]
c:["$","p",null,{"children":["One exception is worth stating plainly: an intellectual-property claim can optionally include a"," ",["$","code",null,{"children":"claimant"}]," field. That field is provided by you, and only if you choose to identify yourself. Anything you type into it is stored with the claim."]}]
d:["$","h3",null,{"id":"app-analytics","children":"App usage (Android app only)"}]
e:["$","p",null,{"children":["The Android app includes"," ",["$","a",null,{"href":"https://firebase.google.com/support/privacy","children":"Firebase Analytics"}],", a Google service, so we can see how many people install the app and which parts of it get used. The website has no equivalent and gets none of this."]}]
f:["$","p",null,{"children":"What Firebase sends to Google from the app:"}]
10:["$","ul",null,{"children":[["$","li",null,{"children":["An ",["$","strong",null,{"children":"app-instance ID"}]," — a random identifier created when you install the app. It is not your device ID and not an advertising ID; deleting the app’s data or uninstalling it destroys it, and a reinstall gets a new one."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Device and app information"}]," — device model, operating-system version, app version, language, and an approximate region derived from the IP address (the IP itself is not retained by Analytics)."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Usage events"}]," — first launch, sessions, screens viewed, and in-app purchase events reported by Google Play."]}]]}]
11:["$","p",null,{"children":["What it does ",["$","em",null,{"children":"not"}]," send: your advertising ID, your Android ID, your name or email, the other apps on your device, or anything you make with an extension. Which extensions you browse or download is not reported to Analytics as identifiable activity."]}]
12:["$","p",null,{"children":["Google processes this data as described in"," ",["$","a",null,{"href":"https://firebase.google.com/support/privacy","children":"Firebase’s privacy documentation"}],". If you would rather not send it, browse the same catalogue on the web at"," ",["$","code",null,{"children":"azphalt.store"}],", which has no analytics."]}]
13:["$","h3",null,{"id":"install-counts","children":"Install counts"}]
14:["$","p",null,{"children":["An app that fetches extensions through Azphalt can tell us that an install happened, so a developer can see how many installs their extension has. What is recorded is a"," ",["$","strong",null,{"children":"count against the extension"}]," — a number going up — and nothing else."]}]
15:["$","p",null,{"children":"There is deliberately no way for those reports to identify you:"}]
16:["$","ul",null,{"children":[["$","li",null,{"children":["They carry ",["$","strong",null,{"children":"no device id, no advertising id, no install id, no account"}]," — no value of any kind whose purpose is to link two reports together."]}],["$","li",null,{"children":["They never carry a ",["$","strong",null,{"children":"list of what you have installed"}],". One report says “an install of this extension happened”, not “here is this device’s library”."]}],["$","li",null,{"children":"They never carry the names of other apps on your device, or anything you made with an extension."}]]}]
17:["$","p",null,{"children":"A report has to present a one-time token that we issued with the download itself, which is how a count stays tied to a real download rather than to anyone who felt like sending us a number. The token is random, is stored with no record of who received it, and works once."}]
18:["$","p",null,{"children":"Like the ratings and download tallies above, these counters live in the running server’s memory and reset whenever the store is redeployed."}]
19:["$","p",null,{"children":["Because none of this identifies a device, we can count installs and uninstalls but"," ",["$","strong",null,{"children":"cannot"}]," measure how many devices have an extension right now. We do not publish a figure claiming otherwise. The rules above are written down as a specification the store and any app using it must follow, not just a policy statement."]}]
1a:["$","h3",null,{"children":"What an app tells the store on your device"}]
1b:["$","p",null,{"children":["Separately, and ",["$","strong",null,{"children":"without anything leaving your device"}],", an app can tell the Azphalt app which extensions it already has — installed, switched off, downloaded but not installed — so the store can show ",["$","em",null,{"children":"Open"}]," or ",["$","em",null,{"children":"Update"}]," instead of offering you something you already own. That exchange happens between two apps on your phone. It is not sent to us, and the Azphalt app is forbidden from looking at your installed apps to discover it: it only ever learns from an app that deliberately opens the store."]}]
1c:["$","h3",null,{"children":"Purchases"}]
1d:["$","p",null,{"children":"Azphalt never sees or stores your payment-card details. Payment is handled entirely by a payment provider:"}]
1e:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"On the web"}]," — by ",["$","a",null,{"href":"https://stripe.com/privacy","children":"Stripe"}],". Checkout happens on Stripe’s own pages. The store sends Stripe the item and price; Stripe handles the card."]}],["$","li",null,{"children":[["$","strong",null,{"children":"In the Android app"}]," — by"," ",["$","a",null,{"href":"https://policies.google.com/privacy","children":"Google Play Billing"}],". The app receives a purchase token from Google and sends it to the Azphalt registry to confirm the purchase is genuine. The token identifies the transaction, not you."]}]]}]
1f:["$","p",null,{"children":["What Azphalt records for a purchase is a ",["$","strong",null,{"children":"licence"}],": which package was bought and an opaque buyer identifier. Your name, email address and billing address are held by the payment provider, not by Azphalt."]}]
20:["$","p",null,{"children":["Licences are issued as signed tokens your app can verify ",["$","strong",null,{"children":"offline"}],". Using a paid extension does not phone home, so we do not learn when or how often you use anything you bought."]}]
21:["$","h3",null,{"children":"Sellers"}]
22:["$","p",null,{"children":"If you sell extensions, payouts run through Stripe Connect. Stripe collects the identity and bank details it needs to pay you and to meet its legal obligations. Azphalt stores the resulting Stripe account reference so it knows where to route your earnings — it does not receive or store your bank details."}]
23:["$","h2",null,{"children":"The Android app"}]
24:["$","p",null,{"children":"The Azphalt Android app requests internet and network-state access, to reach the store; billing, to purchase paid extensions; and a small number of background permissions that Firebase Analytics adds for its own use — keeping the device awake long enough to upload a batch of events, and reading the Play install referrer. It requests no access to your files, camera, microphone, contacts, or location, and no advertising permissions."}]
25:["$","p",null,{"children":"When another app asks Azphalt to fetch an extension for it, Azphalt is told which app is asking — so it can show only extensions that app can use, and so it can tell you who it is acting for. It hands back the extension file and nothing else. It does not report your installed apps or your activity in them."}]
26:["$","h2",null,{"children":"Extensions themselves"}]
27:["$","p",null,{"children":["Code extensions run in a sandbox with ",["$","strong",null,{"children":"no network access, no filesystem access outside their own package, and no access to your device’s sensors"}],". An extension cannot send your work anywhere, because it cannot reach anywhere."]}]
28:["$","p",null,{"children":"Two categories are different, and are labelled as such in the store:"}]
29:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Companion apps"}]," are separate applications with their own permissions, granted by you to that app. You are asked before anything is handed to one."]}],["$","li",null,{"children":[["$","strong",null,{"children":"MCP servers"}]," connect to a service you configure. Their operator’s privacy practices apply, not ours."]}]]}]
2a:["$","h2",null,{"children":"Who else receives data"}]
2b:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Vercel"}]," — hosting and server logs."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Stripe"}]," — web payments and seller payouts."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Google"}]," — Play Billing for in-app purchases, Play distribution, and Firebase Analytics in the Android app."]}],["$","li",null,{"children":[["$","strong",null,{"children":"GitHub"}]," — where extension source and the store’s own code are hosted. Contributing is public by nature."]}]]}]
2c:["$","p",null,{"children":"Azphalt does not sell data, does not share it for advertising, and has no advertising partners."}]
2d:["$","h2",null,{"children":"Your rights"}]
2e:["$","p",null,{"children":"Because there are no accounts and almost nothing is retained, most data-subject requests have no data to act on — there is no profile to export or delete. Where something does exist, such as a purchase licence or a claim you submitted, you can ask us to provide or remove it."}]
2f:["$","p",null,{"children":"For payment records, contact the payment provider directly; they hold that data and can act on it."}]
30:["$","p",null,{"children":"For the app’s analytics, the identifier everything is keyed to is destroyed by clearing the app’s data or uninstalling it, which leaves the past events with nothing to link them to. Ask us if you would like the underlying records deleted as well."}]
31:["$","h2",null,{"children":"Children"}]
32:["$","p",null,{"children":"Azphalt is not directed at children under 13 and does not knowingly collect their data. Some extensions are flagged by their developers as adult content and are age-gated in the store."}]
33:["$","h2",null,{"children":"Changes"}]
34:["$","p",null,{"children":"If this policy changes, the date at the top changes with it. The history of this page is public in the store’s repository, so any change is visible as a diff."}]
35:["$","h2",null,{"children":"Contact"}]
36:["$","p",null,{"children":["Questions about this policy, or a request about your data:"," ",["$","a",null,{"href":"mailto:hereliesaz@gmail.com","children":"hereliesaz@gmail.com"}],"."]}]
37:["$","p",null,{"className":"legal_footer__ZKXiQ","children":["See also the ",["$","a",null,{"href":"/terms","children":"Terms of Service"}],"."]}]
