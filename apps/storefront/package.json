{
  "name": "@azphalt/storefront",
  "version": "0.1.5",
  "private": true,
  "description": "The azphalt.store catalog: the git-pinned registry (registry/) and the scripts that build and verify it. The storefront itself is apps/storefront-react + apps/storefront-worker.",
  "license": "Apache-2.0",
  "author": "Az (https://hereliesaz.com)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build-catalog": "tsx scripts/build-catalog.ts",
    "build-previews": "tsx scripts/build-previews.ts",
    "gen-llm-packages": "tsx scripts/gen-llm-packages.ts"
  },
  "dependencies": {
    "@azphalt/azdk": "workspace:*",
    "@azphalt/azp": "workspace:*",
    "@azphalt/runtime-reference": "workspace:*",
    "tar-stream": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/tar-stream": "^3.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
