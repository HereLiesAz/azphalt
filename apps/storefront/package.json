{
  "name": "@azphalt/storefront",
  "version": "0.1.5",
  "private": true,
  "description": "The azphalt consignment marketplace storefront — a Next.js app on the open standard.",
  "license": "MIT",
  "author": "Az (https://hereliesaz.com)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "next build && node scripts/bundle.mjs",
    "embed-docs": "node scripts/embed-docs.mjs",
    "build-catalog": "tsx scripts/build-catalog.ts",
    "seed": "tsx scripts/seed.ts",
    "clean": "rm -rf .next dist-server public/_docs",
    "build-previews": "tsx scripts/build-previews.ts"
  },
  "dependencies": {
    "@azphalt/azdk": "workspace:*",
    "@azphalt/azp": "workspace:*",
    "@azphalt/registry": "workspace:*",
    "@azphalt/registry-store-vercel": "workspace:*",
    "@azphalt/repository-server": "workspace:*",
    "@azphalt/runtime-reference": "workspace:*",
    "@stripe/stripe-js": "^9.17.0",
    "framer-motion": "^13.4.4",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^22.6.2",
    "tar-stream": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tar-stream": "^3.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
