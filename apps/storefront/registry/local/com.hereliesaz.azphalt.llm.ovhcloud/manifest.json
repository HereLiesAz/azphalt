{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.llm.ovhcloud",
  "name": "OVHcloud Qwen3 Coder 30B",
  "version": "1.0.0",
  "kind": "llm",
  "license": "Apache-2.0",
  "compat": ">=0.1",
  "description": "Qwen3-Coder-30B-A3B on OVHcloud AI Endpoints, no key needed. Anonymous use is two requests a minute per IP.",
  "author": "HereLiesAz",
  "llm": {
    "tier": "endpoint",
    "inputs": [
      {
        "id": "providerKey",
        "type": "promptString",
        "password": true,
        "optional": true,
        "description": "OVHcloud AI Endpoints key (optional; lifts the anonymous limit)"
      }
    ],
    "setup": {
      "sandbox": "github-actions",
      "script": "setup/setup.sh",
      "requires": {
        "githubToken": [
          "contents:write",
          "actions:write",
          "checks:write",
          "workflows:write",
          "secrets:write"
        ]
      },
      "secrets": [
        {
          "name": "PROVIDER_KEY",
          "input": "providerKey"
        }
      ],
      "fetches": []
    },
    "endpoint": {
      "protocols": [
        "openai-chat",
        "github-actions-runner"
      ],
      "baseUrl": "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1",
      "defaultModel": "Qwen3-Coder-30B-A3B-Instruct",
      "auth": "optional-bearer",
      "authInput": "providerKey"
    },
    "run": {
      "permissions": {
        "contents": "read",
        "checks": "write"
      }
    },
    "dataHandling": {
      "prompts": "unknown",
      "modelPinned": true,
      "operator": "OVHcloud",
      "terms": "https://www.ovhcloud.com/en/terms-and-conditions/"
    },
    "role": "text-generation"
  }
}
