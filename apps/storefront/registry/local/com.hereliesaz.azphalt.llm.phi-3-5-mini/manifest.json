{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.llm.phi-3-5-mini",
  "name": "Phi-3.5 Mini Instruct (private sandbox)",
  "version": "1.0.0",
  "kind": "llm",
  "license": "Apache-2.0",
  "compat": ">=0.1",
  "description": "Microsoft's Phi-3.5 Mini Instruct, 4-bit, run by llama.cpp in your own private GitHub Actions sandbox. The largest here; keyless.",
  "author": "HereLiesAz",
  "llm": {
    "tier": "sandbox-weights",
    "setup": {
      "sandbox": "github-actions",
      "script": "setup/setup.sh",
      "requires": {
        "githubToken": [
          "contents:write",
          "actions:write",
          "checks:write",
          "workflows:write"
        ]
      },
      "fetches": [
        {
          "url": "https://github.com/ggml-org/llama.cpp/releases/download/b11218/llama-b11218-bin-ubuntu-x64.tar.gz",
          "checksum": "sha256-9ed52d78e24bfdadad0637a6481fb79a4bb26ddd61cf40ae3d4c56f6bbead793"
        }
      ]
    },
    "weights": {
      "runtime": "llama.cpp",
      "files": [
        {
          "name": "model.gguf",
          "remoteUrl": "https://huggingface.co/bartowski/Phi-3.5-mini-instruct-GGUF/resolve/main/Phi-3.5-mini-instruct-Q4_K_M.gguf",
          "checksum": "sha256-e4165e3a71af97f1b4820da61079826d8752a2088e313af0c7d346796c38eff5",
          "byteSize": 2393232672,
          "supportsRange": true
        }
      ],
      "modelLicense": {
        "spdx": "MIT",
        "commercialUse": true,
        "sourceUrl": "https://huggingface.co/bartowski/Phi-3.5-mini-instruct-GGUF"
      },
      "requirements": {
        "accelerator": "cpu",
        "quantization": "int4",
        "minRamMB": 5120,
        "minDiskMB": 4096,
        "minCpuCores": 2,
        "contextTokens": 4096
      }
    },
    "endpoint": {
      "protocols": [
        "github-actions-runner"
      ],
      "defaultModel": "model.gguf",
      "auth": "none"
    },
    "run": {
      "permissions": {
        "contents": "read",
        "checks": "write"
      }
    },
    "dataHandling": {
      "prompts": "not-retained",
      "modelPinned": true,
      "operator": "GitHub (your private sandbox runner only)"
    },
    "role": "text-generation"
  }
}
