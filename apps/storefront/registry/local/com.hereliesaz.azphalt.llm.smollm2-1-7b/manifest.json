{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.llm.smollm2-1-7b",
  "name": "SmolLM2 1.7B Instruct (private sandbox)",
  "version": "1.0.0",
  "kind": "llm",
  "license": "Apache-2.0",
  "compat": ">=0.1",
  "description": "Hugging Face's SmolLM2 1.7B Instruct, 4-bit, run by llama.cpp in your own private GitHub Actions sandbox. Keyless.",
  "author": "HereLiesAz",
  "llm": {
    "tier": "sandbox-weights",
    "setup": {
      "sandbox": "github-actions",
      "script": "setup/setup.sh",
      "requires": {
        "githubToken": [
          "contents:write",
          "actions:write",
          "checks:write",
          "workflows:write"
        ]
      },
      "fetches": [
        {
          "url": "https://github.com/ggml-org/llama.cpp/releases/download/b11218/llama-b11218-bin-ubuntu-x64.tar.gz",
          "checksum": "sha256-9ed52d78e24bfdadad0637a6481fb79a4bb26ddd61cf40ae3d4c56f6bbead793"
        }
      ]
    },
    "weights": {
      "runtime": "llama.cpp",
      "files": [
        {
          "name": "model.gguf",
          "remoteUrl": "https://huggingface.co/HuggingFaceTB/SmolLM2-1.7B-Instruct-GGUF/resolve/main/smollm2-1.7b-instruct-q4_k_m.gguf",
          "checksum": "sha256-decd2598bc2c8ed08c19adc3c8fdd461ee19ed5708679d1c54ef54a5a30d4f33",
          "byteSize": 1055609536,
          "supportsRange": true
        }
      ],
      "modelLicense": {
        "spdx": "Apache-2.0",
        "commercialUse": true,
        "sourceUrl": "https://huggingface.co/HuggingFaceTB/SmolLM2-1.7B-Instruct-GGUF"
      },
      "requirements": {
        "accelerator": "cpu",
        "quantization": "int4",
        "minRamMB": 3072,
        "minDiskMB": 2048,
        "minCpuCores": 2,
        "contextTokens": 4096
      }
    },
    "endpoint": {
      "protocols": [
        "github-actions-runner"
      ],
      "defaultModel": "model.gguf",
      "auth": "none"
    },
    "run": {
      "permissions": {
        "contents": "read",
        "checks": "write"
      }
    },
    "dataHandling": {
      "prompts": "not-retained",
      "modelPinned": true,
      "operator": "GitHub (your private sandbox runner only)"
    },
    "role": "text-generation"
  }
}
