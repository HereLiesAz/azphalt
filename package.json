{
  "name": "azphalt-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "fixtures": "pnpm --filter \"@azphalt/conformance...\" build && pnpm --filter @azphalt/conformance emit",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && pnpm test && changeset publish",
    "release:staged": "bash scripts/publish-staged.sh",
    "release:promote": "bash scripts/promote-latest.sh"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "overrides": {
      "vite@<=6.4.2": "^6.4.3",
      "esbuild@<=0.24.2": ">=0.25.0",
      "postcss@<8.5.23": ">=8.5.23",
      "fast-uri@<3.1.5": "^3.1.5",
      "sharp@<0.35.0": ">=0.35.0",
      "@hono/node-server@<2.0.5": "^2.0.5",
      "hono@<4.12.34": ">=4.12.34",
      "undici@<6.28.0": "^6.28.0",
      "ip-address@<10.3.1": ">=10.3.1",
      "nanoid@<3.3.17": "^3.3.17",
      "js-yaml@<3.15.1": "^3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1"
    }
  }
}
