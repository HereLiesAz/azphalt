{
  "name": "@azphalt/conformance",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "A runnable conformance suite that certifies an azphalt host against the standard.",
  "license": "Apache-2.0",
  "author": "Az (https://hereliesaz.com)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "emit": "node dist/emit-fixtures.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@azphalt/azdk": "workspace:*",
    "@azphalt/azp": "workspace:*"
  },
  "devDependencies": {
    "@azphalt/runtime-wasm": "workspace:*",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "sideEffects": false
}
