{
  "name": "@azphalt/registry-store-vercel",
  "version": "2.0.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "A durable RegistryStore for @azphalt/registry backed by Neon Postgres + Vercel Blob.",
  "license": "MIT",
  "author": "Az (https://hereliesaz.com)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@azphalt/registry": "workspace:*"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.8.0"
  },
  "devDependencies": {
    "@azphalt/registry": "workspace:*",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "sideEffects": false
}
