{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.kinetic.engraver",
  "name": "Engraver",
  "version": "1.0.0",
  "kind": "asset",
  "license": "LicenseRef-Proprietary",
  "compat": ">=0.1",
  "description": "Five brushes with a system. A hatch that keeps its pitch however fast you draw, a cross-hatch that adds angles as you scribble and press, contour lines that curve with the form, a stipple whose density is your pressure and your patience, and a scratchboard blade that throws chips at every hard turn.",
  "author": "HereLiesAz",
  "targetApps": [
    "com.hereliesaz.graffux"
  ],
  "preview": {
    "image": "assets/preview.png"
  },
  "assets": [
    {
      "type": "brush",
      "path": "assets/hatch.png",
      "tags": [
        "hatch",
        "line",
        "engraving"
      ],
      "params": {
        "name": "Hatch",
        "spacing": 0.12,
        "opacity": 1,
        "program": {
          "state": {
            "d0": 26,
            "sd": 0,
            "nxt": 0,
            "pd": 0,
            "ppx": 0,
            "ppy": 0,
            "cnt": 0
          },
          "init": [
            "d0 = diameter; sd = rand() * 89 + 2; ppx = px; ppy = py;"
          ],
          "step": [
            "hide = 1;",
            "let pr = clamp(pressure, 0, 1);",
            "let A = -45;",
            "let sa = abs(sin(heading - A));",
            "let k = d0 * 0.15 / max(sa, 0.5);",
            "let dd = dist - pd;",
            "let l0 = d0 * (0.4 + 1.0 * pr);",
            "let lw = max(d0 * 0.042 * (0.85 + 0.3 * pr), 1.1);",
            "for i in 0..6 {",
            "  if (nxt <= dist) {",
            "    let t = dd > 0.001 ? clamp((nxt - pd) / dd, 0, 1) : 1;",
            "    cnt += 1;",
            "    let h1 = hash(cnt * 3.1 + sd);",
            "    let h2 = hash(cnt * 5.7 + sd + 11);",
            "    let ll = l0 * (0.9 + 0.2 * h1);",
            "    let sh = (h2 - 0.5) * ll * 0.16;",
            "    emit { x: lerp(ppx, px, t) + cos(A) * sh, y: lerp(ppy, py, t) + sin(A) * sh, size: ll, tip: clamp(lw / ll, 0.05, 1), angle: A + (h1 - 0.5) * 1.6, alpha: 1 };",
            "    nxt += k;",
            "  }",
            "}",
            "if (nxt < dist - k) { nxt = dist; }",
            "pd = dist; ppx = px; ppy = py;"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/crosshatch.png",
      "tags": [
        "hatch",
        "tone",
        "engraving"
      ],
      "params": {
        "name": "Cross-Hatch",
        "spacing": 0.12,
        "opacity": 1,
        "program": {
          "state": {
            "d0": 26,
            "sd": 0,
            "n0": 0,
            "n1": 0,
            "n2": 0,
            "pd": 0,
            "ppx": 0,
            "ppy": 0
          },
          "init": [
            "d0 = diameter; sd = rand() * 89 + 2; ppx = px; ppy = py;"
          ],
          "step": [
            "hide = 1;",
            "let pr = clamp(pressure, 0, 1);",
            "let lvl = pr * 0.8 + min(dist / (d0 * 9), 0.9);",
            "let dd = dist - pd;",
            "let l0 = d0 * (0.4 + 0.95 * pr);",
            "let lw = max(d0 * 0.04 * (0.85 + 0.3 * pr), 1.1);",
            "if (1) {",
            "  let g = 1;",
            "  let sa = abs(sin(heading - (-45)));",
            "  let k = d0 * 0.16 / max(sa, 0.5);",
            "  for i in 0..5 {",
            "    if (n0 <= dist) {",
            "      if (g > 0.03) {",
            "        let t = dd > 0.001 ? clamp((n0 - pd) / dd, 0, 1) : 1;",
            "        let h1 = hash(floor(n0) * 1.37 + sd + 0);",
            "        let h2 = hash(floor(n0) * 2.91 + sd + 5);",
            "        let ll = l0 * 1 * g * (0.88 + 0.24 * h1);",
            "        let sh = (h2 - 0.5) * ll * 0.14;",
            "        emit { x: lerp(ppx, px, t) + cos(-45) * sh, y: lerp(ppy, py, t) + sin(-45) * sh, size: ll, tip: clamp(lw * (0.8 + 0.2 * g) / ll, 0.05, 1), angle: -45 + (h1 - 0.5) * 1.6, alpha: 1 };",
            "      }",
            "      n0 += k;",
            "    }",
            "  }",
            "  if (n0 < dist - k) { n0 = dist; }",
            "}",
            "if (1) {",
            "  let g = smoothstep(0.55, 0.8, lvl);",
            "  let sa = abs(sin(heading - (45)));",
            "  let k = d0 * 0.18 / max(sa, 0.5);",
            "  for i in 0..5 {",
            "    if (n1 <= dist) {",
            "      if (g > 0.03) {",
            "        let t = dd > 0.001 ? clamp((n1 - pd) / dd, 0, 1) : 1;",
            "        let h1 = hash(floor(n1) * 1.37 + sd + 17);",
            "        let h2 = hash(floor(n1) * 2.91 + sd + 34);",
            "        let ll = l0 * 0.95 * g * (0.88 + 0.24 * h1);",
            "        let sh = (h2 - 0.5) * ll * 0.14;",
            "        emit { x: lerp(ppx, px, t) + cos(45) * sh, y: lerp(ppy, py, t) + sin(45) * sh, size: ll, tip: clamp(lw * (0.8 + 0.2 * g) / ll, 0.05, 1), angle: 45 + (h1 - 0.5) * 1.6, alpha: 1 };",
            "      }",
            "      n1 += k;",
            "    }",
            "  }",
            "  if (n1 < dist - k) { n1 = dist; }",
            "}",
            "if (1) {",
            "  let g = smoothstep(1.0, 1.3, lvl);",
            "  let sa = abs(sin(heading - (90)));",
            "  let k = d0 * 0.24 / max(sa, 0.5);",
            "  for i in 0..5 {",
            "    if (n2 <= dist) {",
            "      if (g > 0.03) {",
            "        let t = dd > 0.001 ? clamp((n2 - pd) / dd, 0, 1) : 1;",
            "        let h1 = hash(floor(n2) * 1.37 + sd + 34);",
            "        let h2 = hash(floor(n2) * 2.91 + sd + 63);",
            "        let ll = l0 * 0.7 * g * (0.88 + 0.24 * h1);",
            "        let sh = (h2 - 0.5) * ll * 0.14;",
            "        emit { x: lerp(ppx, px, t) + cos(90) * sh, y: lerp(ppy, py, t) + sin(90) * sh, size: ll, tip: clamp(lw * (0.8 + 0.2 * g) / ll, 0.05, 1), angle: 90 + (h1 - 0.5) * 1.6, alpha: 1 };",
            "      }",
            "      n2 += k;",
            "    }",
            "  }",
            "  if (n2 < dist - k) { n2 = dist; }",
            "}",
            "pd = dist; ppx = px; ppy = py;"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/contour.png",
      "tags": [
        "contour",
        "line",
        "engraving"
      ],
      "params": {
        "name": "Contour",
        "spacing": 0.12,
        "opacity": 1,
        "program": {
          "state": {
            "d0": 26,
            "sd": 0,
            "dx": 1,
            "dy": 0,
            "nxt": 0,
            "pd": 0,
            "ppx": 0,
            "ppy": 0,
            "kap": 0,
            "cnt": 0
          },
          "init": [
            "d0 = diameter; sd = rand() * 89 + 2; ppx = px; ppy = py;"
          ],
          "step": [
            "hide = 1;",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.35); dy = lerp(dy, sin(heading), 0.35);",
            "}",
            "let dl = hypot(dx, dy);",
            "let tx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ty = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = tx; dy = ty;",
            "let pr = clamp(pressure, 0, 1);",
            "let nx = -ty;",
            "let ny = tx;",
            "kap = lerp(kap, index > 0 ? turn / max(stepPx, 0.5) : 0, 0.25);",
            "let kn = clamp(kap * d0 / 36, -1, 1);",
            "let k = d0 * 0.19;",
            "let dd = dist - pd;",
            "let lw = max(d0 * 0.05 * (0.85 + 0.3 * pr), 1.05);",
            "for i in 0..4 {",
            "  if (nxt <= dist) {",
            "    let t = dd > 0.001 ? clamp((nxt - pd) / dd, 0, 1) : 1;",
            "    cnt += 1;",
            "    let cx = lerp(ppx, px, t);",
            "    let cy = lerp(ppy, py, t);",
            "    let hh = hash(cnt * 3.3 + sd);",
            "    let hl0 = d0 * (0.5 + 0.9 * pr) * (0.78 + 0.34 * noise(nxt / (d0 * 2.2) + sd)) * (0.95 + 0.1 * hh) * 0.5;",
            "    let rmax = abs(kap) > 0.01 ? 57.3 / abs(kap) : 9999;",
            "    let hl = min(hl0, max(rmax * 0.85, d0 * 0.12));",
            "    let bow = hl * (0.25 + 0.2 * kn);",
            "    let sk = hl * 0.25 * kn;",
            "    let ax = cx - nx * hl + tx * (sk * -1);",
            "    let ay = cy - ny * hl + ty * (sk * -1);",
            "    let lx = ax;",
            "    let ly = ay;",
            "    for s in 0..6 {",
            "      let u1 = (s + 1) / 3 - 1;",
            "      let bb = bow * (1 - u1 * u1) + sk * u1;",
            "      let qx = cx + nx * hl * u1 + tx * bb;",
            "      let qy = cy + ny * hl * u1 + ty * bb;",
            "      let u5 = (s + 0.5) / 3 - 1;",
            "      let w = lw * (0.3 + 0.7 * pow(1 - u5 * u5, 0.6));",
            "      let sg = hypot(qx - lx, qy - ly);",
            "      emit { x: (qx + lx) * 0.5, y: (qy + ly) * 0.5, size: sg * 1.5 + w, tip: clamp(w / (sg * 1.5 + w), 0.05, 1), angle: atan2(qy - ly, qx - lx), alpha: 1 };",
            "      lx = qx; ly = qy;",
            "    }",
            "    nxt += k;",
            "  }",
            "}",
            "if (nxt < dist - k) { nxt = dist; }",
            "pd = dist; ppx = px; ppy = py;"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/stipple.png",
      "tags": [
        "stipple",
        "dots",
        "tone"
      ],
      "params": {
        "name": "Stipple",
        "spacing": 0.12,
        "opacity": 1,
        "program": {
          "state": {
            "d0": 26,
            "sd": 0,
            "dx": 1,
            "dy": 0
          },
          "init": [
            "d0 = diameter; sd = rand() * 89 + 2;"
          ],
          "step": [
            "hide = 1;",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.35); dy = lerp(dy, sin(heading), 0.35);",
            "}",
            "let dl = hypot(dx, dy);",
            "let tx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ty = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = tx; dy = ty;",
            "let pr = clamp(pressure, 0, 1);",
            "let slow = 1 - smoothstep(0.1, 2.0, speed);",
            "let wd = d0 * (0.5 + 0.5 * pr);",
            "let tone = 0.55 + 0.9 * noise(dist / (d0 * 2.5) + sd);",
            "let e = (stepPx + 0.6) * wd / (d0 * d0) * 70 * (0.3 + 1.1 * pr) * (0.55 + 0.9 * slow) * tone;",
            "if (index == 0) { e += 4 + min(dwell, 800) * 0.01; }",
            "let nn = min(floor(e + hash(index * 7.7 + sd)), 24);",
            "for j in 0..24 {",
            "  if (j < nn) {",
            "    let s1 = index * 41.7 + j * 13.1 + sd * 0.37;",
            "    let h1 = hash(s1);",
            "    let h2 = hash(s1 + 3.3);",
            "    let h3 = hash(s1 + 7.9);",
            "    let h4 = hash(s1 + 11.3);",
            "    let r = h2 * 2 - 1;",
            "    let sr = abs(r);",
            "    let ed = lerp(sr, 1 - pow(1 - sr, 2.2), 0.75);",
            "    let off = sign(r) * ed * wd * 0.5;",
            "    let al = (h1 - 0.5) * (stepPx + 0.6);",
            "    let sz = max(d0 * (0.06 + 0.06 * h3) * (1 - 0.3 * ed), 1.3);",
            "    emit { x: px + tx * al - ty * off, y: py + ty * al + tx * off, size: sz, tip: 1, angle: h4 * 360, alpha: 1 };",
            "  }",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/scratchboard.png",
      "tags": [
        "scratchboard",
        "cut",
        "line"
      ],
      "params": {
        "name": "Scratchboard",
        "spacing": 0.1,
        "opacity": 1,
        "program": {
          "state": {
            "d0": 26,
            "sd": 0,
            "dx": 1,
            "dy": 0,
            "ppx": 0,
            "ppy": 0,
            "pnx": 0,
            "pny": 1,
            "lastc": -999,
            "cnt": 0
          },
          "init": [
            "d0 = diameter; sd = rand() * 89 + 2; ppx = px; ppy = py;"
          ],
          "step": [
            "hide = 1;",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.35); dy = lerp(dy, sin(heading), 0.35);",
            "}",
            "let dl = hypot(dx, dy);",
            "let tx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ty = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = tx; dy = ty;",
            "let pr = clamp(pressure, 0, 1);",
            "let fast = smoothstep(0.3, 3, speed);",
            "let nx = -ty;",
            "let ny = tx;",
            "let ent = pow(smoothstep(0, d0 * 1.8, dist), 0.75);",
            "let w = max(d0 * (0.035 + 0.15 * pow(pr, 1.3)) * (1 - 0.55 * fast) * (0.6 + 0.8 * noise(dist / (d0 * 2.2) + sd)), 1) * (0.1 + 0.9 * ent);",
            "let ex = px - ppx;",
            "let ey = py - ppy;",
            "let sg = hypot(ex, ey);",
            "if (index > 0 && sg > 0.05) {",
            "  let an = atan2(ey, ex);",
            "  emit { x: (px + ppx) * 0.5, y: (py + ppy) * 0.5, size: sg * 1.7 + w, tip: clamp(w / (sg * 1.7 + w), 0.05, 1), angle: an, alpha: 1 };",
            "  let dl2 = smoothstep(0.6, 0.9, pr);",
            "  if (dl2 > 0.02) {",
            "    let ow = w * 0.5 + d0 * 0.085;",
            "    let lw = max(d0 * 0.022, 1) * (0.2 + 0.8 * ent);",
            "    for s in 0..2 {",
            "      let sn = s * 2 - 1;",
            "      let ax = px + nx * ow * sn;",
            "      let ay = py + ny * ow * sn;",
            "      let bx = ppx + pnx * ow * sn;",
            "      let by = ppy + pny * ow * sn;",
            "      let sl = hypot(ax - bx, ay - by);",
            "      emit { x: (ax + bx) * 0.5, y: (ay + by) * 0.5, size: sl * 1.7 + lw, tip: clamp(lw / (sl * 1.7 + lw), 0.05, 1), angle: atan2(ay - by, ax - bx), alpha: 0.4 * dl2 };",
            "    }",
            "  }",
            "}",
            "// chips: thrown from the first touch and from every sharp turn, to the outside of the bend",
            "let burst = 0;",
            "if (index == 0) { burst = 1; } else if (abs(turn) > 16 && dist - lastc > d0 * 0.6) { burst = 2; }",
            "if (burst > 0) {",
            "  lastc = dist;",
            "  let side0 = turn > 0 ? -1 : 1;",
            "  let nc = burst == 1 ? 4 + floor(pr * 2) : 3 + floor(min(abs(turn) / 40, 2));",
            "  for c in 0..8 {",
            "    if (c < nc) {",
            "      cnt += 1;",
            "      let h1 = hash(cnt * 3.7 + sd);",
            "      let h2 = hash(cnt * 5.1 + sd + 13);",
            "      let h3 = hash(cnt * 7.3 + sd + 29);",
            "      let sd2 = burst == 1 ? (h3 < 0.5 ? -1 : 1) : side0;",
            "      let ca = heading + sd2 * (burst == 1 ? 55 + 45 * h1 : 20 + 45 * h1) + (h2 - 0.5) * 12;",
            "      let ccs = cos(ca);",
            "      let csn = sin(ca);",
            "      let o0 = w * 0.6 + d0 * (0.07 + 0.14 * h2);",
            "      let lc = d0 * (0.18 + 0.4 * h2 * h1) * (0.7 + 0.5 * pr);",
            "      let wc = max(d0 * 0.065, 1.4);",
            "      let ao = (h3 - 0.5) * d0 * 0.8;",
            "      let ox = px + ccs * o0 + tx * ao;",
            "      let oy = py + csn * o0 + ty * ao;",
            "      for q in 0..3 {",
            "        let sl = lc / 3;",
            "        let st = o0 * 0 + q * sl;",
            "        let wq = wc * (1 - 0.33 * q) * (1 - 0.3 * h1);",
            "        emit { x: ox + ccs * (st + sl * 0.5), y: oy + csn * (st + sl * 0.5), size: sl * 1.4 + wq, tip: clamp(wq / (sl * 1.4 + wq), 0.05, 1), angle: ca, alpha: 1 - 0.08 * q };",
            "      }",
            "      emit { x: ox + ccs * lc * 1.12, y: oy + csn * lc * 1.12, size: max(wc * 0.9, 1), tip: 1, alpha: 0.9 };",
            "    }",
            "  }",
            "}",
            "ppx = px; ppy = py; pnx = nx; pny = ny;"
          ]
        }
      }
    }
  ]
}