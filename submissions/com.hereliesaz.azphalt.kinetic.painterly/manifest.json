{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.kinetic.painterly",
  "name": "Painterly Kinetic",
  "version": "1.0.0",
  "kind": "asset",
  "license": "LicenseRef-Proprietary",
  "compat": ">=0.1",
  "description": "Five media that behave like themselves: oil that runs dry into broken colour on the weave, gouache that covers and then streaks, charcoal that wears flat and sheds dust, watercolour that blooms only where you drop it into paint that is still wet, and a knife that lays ridged slabs and scrapes when it is empty.",
  "author": "HereLiesAz",
  "targetApps": [
    "com.hereliesaz.graffux"
  ],
  "preview": {
    "image": "assets/preview.png"
  },
  "assets": [
    {
      "type": "brush",
      "path": "assets/heavy-oil.png",
      "tags": [
        "oil",
        "bristle",
        "broken colour"
      ],
      "params": {
        "name": "Heavy Oil",
        "spacing": 0.14,
        "opacity": 1,
        "impastoThicknessRate": 0.35,
        "impastoMaterial": {
          "version": 2,
          "enabled": true,
          "initialLoad": 1,
          "wetness": 0.7,
          "pickupRate": 0.35,
          "levelingRate": 0.08,
          "viscosity": 0.85,
          "yieldLikeStrength": 0.75,
          "substrateResponse": 0.35,
          "baseRoughness": 0.55,
          "wetSpecularStrength": 0.6
        },
        "program": {
          "state": {
            "load": 1,
            "d0": 26,
            "n": 12,
            "gofs": 0,
            "dx": 1,
            "dy": 0
          },
          "init": [
            "d0 = diameter;",
            "n = clamp(floor(d0 / 2.1), 7, 24);",
            "gofs = hash(5.1);"
          ],
          "step": [
            "let pr = clamp(pressure, 0, 1);",
            "let sp = clamp(layerSpeed / 2.5, 0, 1);",
            "// travel direction, low-passed so a shaky hand does not shake the tool",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.4); dy = lerp(dy, sin(heading), 0.4);",
            "}",
            "let dl = hypot(dx, dy);",
            "let nx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ny = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = nx; dy = ny;",
            "let ang = atan2(ny, nx);",
            "hide = 1;",
            "// wet paint ahead of the brush that this stroke did not just lay: pick it up",
            "let ax = px + nx * d0 * 0.95;",
            "let ay = py + ny * d0 * 0.95;",
            "let wet = wetAt(ax, ay, d0 * 0.4);",
            "let pick = 0;",
            "if (wet > 6 && index > 0) {",
            "  pick = min(wet * 0.35, 40);",
            "  drain(ax, ay, d0 * 0.45, pick);",
            "  load = min(1, load + pick * 0.004 * stepPx / d0);",
            "}",
            "load -= stepPx / (9 * d0 + 150) * (0.45 + 0.9 * pr) * (0.8 + 0.4 * sp);",
            "load = max(load, 0);",
            "let lay = 70 * load * (0.5 + pr);",
            "if (lay > 1) { spray(px, py, d0 * 0.5, lay * stepPx / d0); }",
            "let wspan = d0 * (0.72 + 0.4 * pr);",
            "let cw = wspan / n;",
            "let len = max(stepPx * 2.6, cw * 2.2);",
            "let splay = clamp(abs(turn) / 50, 0, 1);",
            "let kt = 1 / max(2.2, d0 * 0.14);",
            "let smear = clamp(pick / 25, 0, 1);",
            "for i in 0..24 {",
            "  if (i < n) {",
            "    let u = (i + 0.5) / n - 0.5;",
            "    let t = fract(i * 0.618034 + gofs);",
            "    let wob = (noise(i * 7.3 + dist / (d0 * 2)) - 0.5) * cw * (0.4 + 1.5 * (1 - load) + 2 * splay);",
            "    let off = u * wspan * (1 + 0.25 * splay) + wob;",
            "    let bx = px - ny * off;",
            "    let by = py + nx * off;",
            "    // the weave: tops catch paint first",
            "    let tooth = noise2(bx * kt, by * kt);",
            "    let le = load * 1.25 + 0.12 * pr + smear * 0.6 - 0.25 * t;",
            "    let catch = smoothstep(0.05, 0.45, le + (tooth - 0.5) * (1.4 - le));",
            "    if (catch > 0.04) {",
            "      let bw = cw * (0.8 + 0.9 * min(le, 1)) * (0.55 + 0.45 * catch);",
            "      emit { x: bx, y: by, size: len, tip: clamp(bw / len, 0.05, 1), angle: ang,",
            "             alpha: baseAlpha * (0.45 + 0.55 * catch), val: 0.84 + 0.16 * hash(i + 3.3) - 0.08 * smear * hash(i + 9.1) };",
            "    }",
            "  }",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/matte-gouache.png",
      "tags": [
        "gouache",
        "flat",
        "opaque"
      ],
      "params": {
        "name": "Matte Gouache",
        "spacing": 0.12,
        "opacity": 1,
        "program": {
          "state": {
            "load": 1,
            "d0": 26,
            "n": 14,
            "gofs": 0,
            "dx": 1,
            "dy": 0
          },
          "init": [
            "d0 = diameter;",
            "n = clamp(floor(d0 / 1.6), 8, 30);",
            "gofs = hash(2.9);"
          ],
          "step": [
            "let pr = clamp(pressure, 0, 1);",
            "let linger = clamp(dt / max(stepPx, 0.1) / 6, 0, 1);",
            "// travel direction, low-passed so a shaky hand does not shake the tool",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.3); dy = lerp(dy, sin(heading), 0.3);",
            "}",
            "let dl = hypot(dx, dy);",
            "let nx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ny = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = nx; dy = ny;",
            "let ang = atan2(ny, nx);",
            "hide = 1;",
            "let ax = px + nx * d0 * 0.8;",
            "let ay = py + ny * d0 * 0.8;",
            "let wet = index > 0 ? wetAt(ax, ay, d0 * 0.35) : 0;",
            "let rewet = smoothstep(4, 22, wet);",
            "load -= stepPx / (10 * d0 + 170) * (0.5 + 0.8 * pr) * (1 + 0.6 * linger);",
            "load = max(load, 0);",
            "let lw = clamp((load - 0.05) / 0.5, 0, 1);",
            "spray(px, py, d0 * 0.5, 45 * lw * stepPx / d0);",
            "let wspan = d0 * (0.86 + 0.18 * pr);",
            "let cw = wspan / n;",
            "let len = max(stepPx * 2.2, cw * 1.5);",
            "let le = max(lw * (1.05 + 0.2 * pr), 0.85 * rewet);",
            "for i in 0..30 {",
            "  if (i < n) {",
            "    let u = (i + 0.5) / n - 0.5;",
            "    let t = fract(i * 0.618034 + gofs);",
            "    // edges dry first, then lanes in their own order; each lane breaks along the stroke",
            "    let thr = 0.15 + 0.7 * t - 0.25 * (1 - abs(u) * 2);",
            "    let br = noise(i * 13.1 + dist / (d0 * 0.9));",
            "    let on = smoothstep(0, 0.12, le - thr + (br - 0.5) * 0.5 * (1 - le));",
            "    if (on > 0.05) {",
            "      let off = u * wspan;",
            "      let edge = (i == 0 || i == n - 1) ? 0.8 : 1;",
            "      emit { x: px - ny * off, y: py + nx * off, size: len, tip: clamp(cw * (0.9 + 0.8 * on) / len, 0.05, 1), angle: ang,",
            "             alpha: baseAlpha * on * edge };",
            "    }",
            "  }",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/compressed-charcoal.png",
      "tags": [
        "charcoal",
        "dry",
        "shading"
      ],
      "params": {
        "name": "Compressed Charcoal",
        "spacing": 0.14,
        "opacity": 0.85,
        "buildUp": true,
        "program": {
          "state": {
            "wear": 0,
            "d0": 26,
            "dx": 1,
            "dy": 0,
            "dust": 0
          },
          "init": [
            "d0 = diameter;"
          ],
          "step": [
            "let pr = clamp(pressure, 0, 1);",
            "let sp = clamp(layerSpeed / 3, 0, 1);",
            "// travel direction, low-passed so a shaky hand does not shake the tool",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.35); dy = lerp(dy, sin(heading), 0.35);",
            "}",
            "let dl = hypot(dx, dy);",
            "let nx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ny = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = nx; dy = ny;",
            "let ang = atan2(ny, nx);",
            "hide = 1;",
            "wear = min(1, wear + stepPx / (22 * d0) * (0.35 + pr));",
            "let w = d0 * (0.3 + 0.7 * pow(wear, 0.7)) * (0.8 + 0.3 * pr);",
            "let m = clamp(floor(w / 1.7), 3, 18);",
            "let cw = w / m;",
            "let len = max(stepPx * 2.4, cw * 2);",
            "let kt = 1 / max(1.6, d0 * 0.075);",
            "let fill = 0.25 + 0.75 * pow(pr, 1.2) - 0.25 * sp;",
            "let dens = (0.5 + 0.5 * pr) * (1 - 0.35 * wear) * (1 - 0.3 * sp);",
            "for j in 0..18 {",
            "  if (j < m) {",
            "    let u = (j + 0.5) / m - 0.5;",
            "    let off = u * w;",
            "    let bx = px - ny * off;",
            "    let by = py + nx * off;",
            "    let tooth = noise2(bx * kt, by * kt);",
            "    let rim = 1 - pow(abs(u) * 2, 3) * 0.6;",
            "    let c = smoothstep(0.2, 0.55, tooth + fill - 0.5) * rim;",
            "    if (c > 0.04) {",
            "      emit { x: bx, y: by, size: len, tip: clamp(cw * 1.5 / len, 0.05, 1), angle: ang + rands() * 6,",
            "             alpha: dens * (0.25 + 0.75 * c) };",
            "    }",
            "  }",
            "}",
            "// powder: shed in proportion to pressure, distance and the corners you turn",
            "dust += stepPx / d0 * (0.6 * pr * pr + 0.015 * abs(turn)) * 3;",
            "for k in 0..6 {",
            "  if (dust >= 1) {",
            "    dust -= 1;",
            "    let s = rands();",
            "    let fall = rand();",
            "    emit { x: px - ny * s * w * 0.6 + rands() * d0 * 0.2, y: py + nx * s * w * 0.6 + fall * fall * d0 * 0.8,",
            "           size: d0 * (0.03 + 0.07 * rand() * rand()) + 0.8, tip: 1, angle: rand() * 360, alpha: 0.2 + 0.35 * rand() };",
            "  }",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/cauliflower-bloom.png",
      "tags": [
        "watercolor",
        "bloom",
        "wet"
      ],
      "params": {
        "name": "Cauliflower Bloom",
        "spacing": 0.2,
        "opacity": 1,
        "buildUp": true,
        "program": {
          "state": {
            "water": 1,
            "d0": 26,
            "dx": 1,
            "dy": 0,
            "lastB": -999,
            "bx": 0,
            "by": 0,
            "bR": 0,
            "bAge": 0,
            "bF": 0,
            "pool": 0,
            "poolR": 0
          },
          "init": [
            "d0 = diameter;"
          ],
          "tickMs": 16,
          "step": [
            "let pr = clamp(pressure, 0, 1);",
            "let dts = dt / 1000;",
            "hide = 1;",
            "// travel direction, low-passed so a shaky hand does not shake the tool",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.4); dy = lerp(dy, sin(heading), 0.4);",
            "}",
            "let dl = hypot(dx, dy);",
            "let nx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ny = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = nx; dy = ny;",
            "let ang = atan2(ny, nx);",
            "let r = d0 * (0.42 + 0.2 * pr);",
            "// wet paint that this stroke has not just laid itself: under the touchdown, ahead when moving",
            "let foreign = 0;",
            "if (phase == 0) { foreign = wetAt(px, py, r * 0.8); }",
            "if (phase == 1) { foreign = wetAt(px + nx * r * 1.7, py + ny * r * 1.7, r * 0.5); }",
            "if (phase != 3) {",
            "  // the brush gives water by distance and, held, by time",
            "  let give = water * (stepPx / d0 * 0.55 + dts * 1.6 * pr + (phase == 0 ? 0.25 : 0));",
            "  water = max(0, water - give * 0.035);",
            "  let dh = 120 * give;",
            "  if (dh > 0.2) { spray(px, py, r, dh); }",
            "  if (phase != 2) {",
            "    emit { size: r * 2 * (0.9 + 0.15 * rand()), alpha: (0.13 + 0.1 * pr) * (0.4 + 0.6 * water), angle: rand() * 360,",
            "           val: 0.9 + 0.1 * rand() };",
            "  }",
            "  // a held brush pools: the puddle widens and leaves a tide line",
            "  if (phase == 1) { pool = 0; poolR = 0; }",
            "  if (phase == 2) {",
            "    pool += dts * pr * water;",
            "    let pr2 = r * (1 + 1.1 * sqrt(pool));",
            "    if (pr2 > poolR + max(1, d0 * 0.05)) {",
            "      poolR = pr2;",
            "      emit { size: poolR * 2, alpha: 0.1 + 0.06 * pr, angle: rand() * 360, val: 0.95 };",
            "    }",
            "  }",
            "}",
            "// a new bloom where fresh water meets wet paint",
            "let still = smoothstep(6, 40, foreign) * water;",
            "if (still > 0.15 && dist - lastB > d0 * 1.1 && bF <= 0) {",
            "  lastB = dist;",
            "  bx = px; by = py; bR = r * (0.7 + 0.3 * still); bAge = 0; bF = still;",
            "}",
            "// a live bloom spreads (fast at first, slowing as the water sinks in) and stamps its lobed edge",
            "if (bF > 0) {",
            "  bAge += dts;",
            "  let reach = r * (0.9 + 1.4 * bF) * (1 - exp(-bAge / 0.35)) + r * 0.6;",
            "  let held = (phase == 2 && hypot(px - bx, py - by) < r) ? 1 : 0;",
            "  if (held > 0) { reach = reach + r * 0.9 * sqrt(bAge); }",
            "  let fin = (phase == 3 || hypot(px - bx, py - by) > reach + r * 1.5 || bAge > 4) ? 1 : 0;",
            "  if (reach > bR + max(1.2, d0 * 0.09) || fin > 0) {",
            "    bR = max(bR, reach);",
            "    let ring = fin > 0 ? 1 : 0.45;",
            "    for k in 0..32 {",
            "      let a = k * 11.25 + hash(k + bx * 0.01) * 6;",
            "      let lob = 1 + 0.16 * (noise(k * 0.55 + bx * 0.013 + by * 0.007) - 0.5) * 2 + 0.06 * sin(a * 5 + bx);",
            "      let rr = bR * lob;",
            "      emit { x: bx + cos(a) * rr, y: by + sin(a) * rr, size: d0 * (0.14 + 0.12 * bF) + bR * 0.2,",
            "             alpha: (0.10 + 0.2 * bF) * ring, angle: a + 90, tip: 0.5, val: 1 };",
            "    }",
            "    if (fin > 0) { bF = 0; }",
            "  }",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/impasto-knife.png",
      "tags": [
        "knife",
        "impasto",
        "scrape"
      ],
      "params": {
        "name": "Impasto Knife",
        "spacing": 0.1,
        "opacity": 1,
        "impastoThicknessRate": 0.65,
        "impastoMaterial": {
          "version": 2,
          "enabled": true,
          "initialLoad": 1,
          "wetness": 0.7,
          "pickupRate": 0.35,
          "levelingRate": 0.08,
          "viscosity": 0.85,
          "yieldLikeStrength": 0.75,
          "substrateResponse": 0.35,
          "baseRoughness": 0.55,
          "wetSpecularStrength": 0.6
        },
        "program": {
          "state": {
            "load": 1,
            "d0": 26,
            "n": 10,
            "dx": 1,
            "dy": 0,
            "gofs": 0
          },
          "init": [
            "d0 = diameter;",
            "n = clamp(floor(d0 / 2.4), 6, 20);",
            "gofs = hash(7.7);"
          ],
          "step": [
            "let pr = clamp(pressure, 0, 1);",
            "// travel direction, low-passed so a shaky hand does not shake the tool",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.22); dy = lerp(dy, sin(heading), 0.22);",
            "}",
            "let dl = hypot(dx, dy);",
            "let nx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ny = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = nx; dy = ny;",
            "let ang = atan2(ny, nx);",
            "hide = 1;",
            "let W = d0 * (0.85 + 0.3 * pr);",
            "let ax = px + nx * d0 * 0.75;",
            "let ay = py + ny * d0 * 0.75;",
            "let wet = index > 0 ? wetAt(ax, ay, W * 0.4) : 0;",
            "let scr = 0;",
            "if (load < 0.5 && wet > 8) {",
            "  scr = min(wet * 0.6, 120) * (0.5 + pr);",
            "  drain(ax, ay, W * 0.45, scr);",
            "  load = min(1, load + scr * 0.0012 * stepPx / d0);",
            "}",
            "load -= stepPx / (6 * d0 + 110) * (0.4 + 0.9 * pr);",
            "load = max(load, 0);",
            "let lay = clamp(load / 0.35, 0, 1);",
            "if (lay > 0.02) { spray(px, py, W * 0.5, 160 * lay * stepPx / d0); }",
            "let sm = smoothstep(4, 50, scr);",
            "let cw = W / n;",
            "let len = max(stepPx * 2.4, cw * 1.6);",
            "// the slab: lanes across the blade; a thin load skates and skips",
            "for i in 0..20 {",
            "  if (i < n) {",
            "    let u = (i + 0.5) / n - 0.5;",
            "    let t = fract(i * 0.618034 + gofs);",
            "    let sk = noise(i * 0.9 + dist / (d0 * 1.6));",
            "    let on = smoothstep(0, 0.2, lay * 1.2 - 0.25 * t + (sk - 0.5) * 0.7 * (1 - lay));",
            "    let a = max(on, 0.35 * sm * (0.4 + 0.6 * sk));",
            "    if (a > 0.04) {",
            "      let off = u * W;",
            "      emit { x: px - ny * off, y: py + nx * off, size: len, tip: clamp(cw * 1.25 / len, 0.05, 1), angle: ang,",
            "             alpha: baseAlpha * a, val: 0.74 + 0.08 * hash(i + 1.7) };",
            "    }",
            "  }",
            "}",
            "// ridges: paint squeezed out at both edges of the blade (and pushed aside when scraping)",
            "let rg = max(lay, sm);",
            "if (rg > 0.05) {",
            "  for e in 0..2 {",
            "    let side = e == 0 ? -0.5 : 0.5;",
            "    let wob = (noise(e * 31 + dist / (d0 * 0.7)) - 0.5) * cw * 0.8;",
            "    let off = side * (W + cw * 0.6) + wob;",
            "    emit { x: px - ny * off, y: py + nx * off, size: len, tip: clamp(cw * (0.55 + 0.5 * rg) / len, 0.05, 1), angle: ang,",
            "           alpha: baseAlpha * (0.6 + 0.4 * rg), val: 1 };",
            "  }",
            "}",
            "// the lip where the blade touched down",
            "if (index == 0) {",
            "  emit { x: px - nx * cw * 0.5, y: py - ny * cw * 0.5, size: W * 1.08, tip: clamp(cw * 0.9 / W, 0.05, 1), angle: ang + 90, alpha: baseAlpha, val: 1 };",
            "}"
          ]
        }
      }
    }
  ]
}
