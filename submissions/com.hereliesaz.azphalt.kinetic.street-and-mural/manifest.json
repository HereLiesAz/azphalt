{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.kinetic.street-and-mural",
  "name": "Street & Mural Kinetic",
  "version": "1.0.0",
  "kind": "asset",
  "license": "LicenseRef-Proprietary",
  "compat": ">=0.1",
  "description": "Five wall tools that behave like the wall: a mop that floods where you hesitate and runs as far as the ink would, paste-up that creases and tears, a stencil edge that bleeds under the card, a roller that laps and starves, and a valve marker you have to pump.",
  "author": "HereLiesAz",
  "targetApps": [
    "com.hereliesaz.graffux"
  ],
  "preview": {
    "image": "assets/preview.png"
  },
  "assets": [
    {
      "type": "brush",
      "path": "assets/pooling-mop.png",
      "tags": [
        "marker",
        "mop",
        "drip",
        "tag"
      ],
      "params": {
        "name": "Pooling Mop",
        "spacing": 0.1,
        "opacity": 1,
        "hardness": 1,
        "buildUp": true,
        "program": {
          "state": {
            "pend": 0,
            "d0v": 0,
            "d0x": 0,
            "d0y": 0,
            "d0w": 0,
            "d0a": 0,
            "d1v": 0,
            "d1x": 0,
            "d1y": 0,
            "d1w": 0,
            "d1a": 0,
            "d2v": 0,
            "d2x": 0,
            "d2y": 0,
            "d2w": 0,
            "d2a": 0
          },
          "step": [
            "let pxcm = diameter / 1.6;",
            "let press = clamp(pressure, 0, 1);",
            "let rcm = 0.8 * (0.8 + 0.2 * press);",
            "let rpx = rcm * pxcm;",
            "let dts = dt / 1000;",
            "hide = 1;",
            "let vol = 0;",
            "if (phase != 3) {",
            "  vol = 0.22 * (0.35 + 0.65 * press) * dts + (phase == 0 ? 0.006 : 0);",
            "}",
            "let dh = 20000 * vol / (PI * rcm * rcm);",
            "if (dh > 0.01) {",
            "  let before = wetAt(px, py, max(rpx * 0.7, 9));",
            "  let rl = max(rpx, 9);",
            "  spray(px, py, rl, dh * rpx * rpx / (rl * rl));",
            "  let pool = smoothstep(40, 220, before);",
            "  // the stamp is the increment of ink; a pool spreads wider and goes glossy-dense",
            "  let cover = 1 - exp(-dh / 22);",
            "  let ga = hash(index) * 360;",
            "  emit { x: px, y: py, size: 2 * rpx * (1 + 0.15 * pool), alpha: cover * (0.85 + 0.15 * pool), angle: ga, val: 1 - 0.1 * pool };",
            "  if (pool > 0.5) {",
            "    emit { x: px + rands() * 0.15 * rpx, y: py + rands() * 0.15 * rpx, size: 2 * rpx * (1.15 + 0.3 * pool), alpha: cover * 0.15, angle: ga + 90, val: 0.9 };",
            "  }",
            "",
            "  let film = wetAt(px, py, max(rpx * 0.6, 9));",
            "  let pour = film - 220;",
            "  if (pour > 0) {",
            "    let rel = pour * 0.4;",
            "    drain(px, py, max(rpx * 0.6, 9), rel);",
            "    let rc = 0.6 * rcm;",
            "    pend = min(0.4, pend + rel * 0.0001 * PI * rc * rc / 3);",
            "  }",
            "}",
            "",
            "if (phase != 3) {",
            "  if (d0v <= 0) {",
            "    if (pend >= 0.004) {",
            "      d0v = pend;",
            "      pend = 0;",
            "      d0x = px + (hash2(index, 0) - 0.5) * 0.8 * rpx;",
            "      d0y = py + 0.35 * rpx;",
            "      d0w = clamp(0.12 + 0.9 * sqrt(d0v), 0.12, 0.32);",
            "      d0a = 0;",
            "    }",
            "  }",
            "}",
            "",
            "if (phase != 3) {",
            "  if (d1v <= 0) {",
            "    if (pend >= 0.004) {",
            "      d1v = pend;",
            "      pend = 0;",
            "      d1x = px + (hash2(index, 1) - 0.5) * 0.8 * rpx;",
            "      d1y = py + 0.35 * rpx;",
            "      d1w = clamp(0.12 + 0.9 * sqrt(d1v), 0.12, 0.32);",
            "      d1a = 0;",
            "    }",
            "  }",
            "}",
            "",
            "if (phase != 3) {",
            "  if (d2v <= 0) {",
            "    if (pend >= 0.004) {",
            "      d2v = pend;",
            "      pend = 0;",
            "      d2x = px + (hash2(index, 2) - 0.5) * 0.8 * rpx;",
            "      d2y = py + 0.35 * rpx;",
            "      d2w = clamp(0.12 + 0.9 * sqrt(d2v), 0.12, 0.32);",
            "      d2a = 0;",
            "    }",
            "  }",
            "}",
            "let reps = 1;",
            "if (phase == 3) { reps = 12; }",
            "let dtr = dts;",
            "if (phase == 3) { dtr = 1.0; }",
            "for c in 0..12 {",
            "  if (c < reps) {",
            "",
            "    if (d0v > 0) {",
            "      d0a = d0a + dtr;",
            "      let sp0 = 6.0 * exp(-d0a / 6.0) * clamp(sqrt(d0v / 0.05), 0.6, 1.7);",
            "      let adv0 = sp0 * dtr;",
            "      let need0 = d0w * 0.005;",
            "      if (adv0 * need0 > d0v) { adv0 = d0v / need0; }",
            "      let y00 = d0y;",
            "      let y10 = y00 + adv0 * pxcm;",
            "      d0v = d0v - adv0 * need0;",
            "      let len0 = (y10 - y00) + d0w * pxcm;",
            "      if (y10 > y00) {",
            "        emit { x: d0x + (noise((y00 + y10) * 0.006 + 0.0) - 0.5) * 0.4 * pxcm, y: (y00 + y10) * 0.5, size: len0 * 1.0, tip: clamp(d0w * pxcm / len0, 0.05, 1), angle: 90, alpha: 0.95, hue: 0, sat: 1, val: 1 };",
            "      }",
            "      d0y = y10;",
            "      if (d0v <= 0.0000001 || sp0 < 0.04) {",
            "        emit { x: d0x + (noise(y10 * 0.006 + 0.0) - 0.5) * 0.4 * pxcm, y: y10 + 0.2 * d0w * pxcm, size: d0w * pxcm * 1.45 * 1.0, alpha: 0.97, angle: 0, tip: 1, val: 1 };",
            "        d0v = 0;",
            "      }",
            "    }",
            "",
            "    if (d1v > 0) {",
            "      d1a = d1a + dtr;",
            "      let sp1 = 6.0 * exp(-d1a / 6.0) * clamp(sqrt(d1v / 0.05), 0.6, 1.7);",
            "      let adv1 = sp1 * dtr;",
            "      let need1 = d1w * 0.005;",
            "      if (adv1 * need1 > d1v) { adv1 = d1v / need1; }",
            "      let y01 = d1y;",
            "      let y11 = y01 + adv1 * pxcm;",
            "      d1v = d1v - adv1 * need1;",
            "      let len1 = (y11 - y01) + d1w * pxcm;",
            "      if (y11 > y01) {",
            "        emit { x: d1x + (noise((y01 + y11) * 0.006 + 9.1) - 0.5) * 0.4 * pxcm, y: (y01 + y11) * 0.5, size: len1 * 1.0, tip: clamp(d1w * pxcm / len1, 0.05, 1), angle: 90, alpha: 0.95, hue: 0, sat: 1, val: 1 };",
            "      }",
            "      d1y = y11;",
            "      if (d1v <= 0.0000001 || sp1 < 0.04) {",
            "        emit { x: d1x + (noise(y11 * 0.006 + 9.1) - 0.5) * 0.4 * pxcm, y: y11 + 0.2 * d1w * pxcm, size: d1w * pxcm * 1.45 * 1.0, alpha: 0.97, angle: 0, tip: 1, val: 1 };",
            "        d1v = 0;",
            "      }",
            "    }",
            "",
            "    if (d2v > 0) {",
            "      d2a = d2a + dtr;",
            "      let sp2 = 6.0 * exp(-d2a / 6.0) * clamp(sqrt(d2v / 0.05), 0.6, 1.7);",
            "      let adv2 = sp2 * dtr;",
            "      let need2 = d2w * 0.005;",
            "      if (adv2 * need2 > d2v) { adv2 = d2v / need2; }",
            "      let y02 = d2y;",
            "      let y12 = y02 + adv2 * pxcm;",
            "      d2v = d2v - adv2 * need2;",
            "      let len2 = (y12 - y02) + d2w * pxcm;",
            "      if (y12 > y02) {",
            "        emit { x: d2x + (noise((y02 + y12) * 0.006 + 18.2) - 0.5) * 0.4 * pxcm, y: (y02 + y12) * 0.5, size: len2 * 1.0, tip: clamp(d2w * pxcm / len2, 0.05, 1), angle: 90, alpha: 0.95, hue: 0, sat: 1, val: 1 };",
            "      }",
            "      d2y = y12;",
            "      if (d2v <= 0.0000001 || sp2 < 0.04) {",
            "        emit { x: d2x + (noise(y12 * 0.006 + 18.2) - 0.5) * 0.4 * pxcm, y: y12 + 0.2 * d2w * pxcm, size: d2w * pxcm * 1.45 * 1.0, alpha: 0.97, angle: 0, tip: 1, val: 1 };",
            "        d2v = 0;",
            "      }",
            "    }",
            "  }",
            "}"
          ],
          "tickMs": 16
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/wheatpaste.png",
      "tags": [
        "poster",
        "paste-up",
        "paper"
      ],
      "params": {
        "name": "Wheatpaste",
        "spacing": 0.28,
        "opacity": 1,
        "hardness": 1,
        "buildUp": true,
        "followStroke": true,
        "program": {
          "state": {
            "tens": 0,
            "slack": 0,
            "gap": 0,
            "cxp": 0,
            "cyp": 0,
            "ca": 0,
            "cl": 0,
            "cw": 0,
            "cd": 0
          },
          "step": [
            "let d = diameter;",
            "let h = heading;",
            "hide = 1;",
            "let cx = cos(h);",
            "let sx = sin(h);",
            "let nx = -sx;",
            "let ny = cx;",
            "let wet = wetAt(px, py, d * 0.4);",
            "spray(px, py, d * 0.55, 30);",
            "let linger = clamp(dt / max(stepPx, 0.5) * 0.25, 0, 1);",
            "if (index == 0) { tens = 0; slack = 0.6; }",
            "slack += abs(turn) / 70 + linger * 0.35 + smoothstep(20, 120, wet) * 0.5 + 0.06;",
            "tens += clamp((layerSpeed - 1.2) / 2.0, 0, 1) * stepPx / d * 0.9 + abs(turn) / 400;",
            "tens = max(0, tens - stepPx / d * 0.08);",
            "if (gap > 0) {",
            "  gap -= stepPx;",
            "  if (gap <= 0) {",
            "    // the far lip of the tear: ragged fibres, curling white",
            "    for i in 0..5 {",
            "      let o = (i - 2) / 4 * d * 0.8;",
            "      emit { x: px + nx * o + cx * rands() * 0.08 * d, y: py + ny * o + sx * rands() * 0.08 * d, size: d * (0.18 + 0.12 * rand()), angle: rand() * 360, tip: 0.5 + 0.5 * rand(), alpha: 0.9, val: 1.0 };",
            "    }",
            "  }",
            "} else if (tens > 1 && dist > d * 1.5) {",
            "  tens = 0;",
            "  gap = d * (0.35 + 0.5 * rand());",
            "  for i in 0..5 {",
            "    let o = (i - 2) / 4 * d * 0.8;",
            "    emit { x: px + nx * o + cx * rands() * 0.1 * d, y: py + ny * o + sx * rands() * 0.1 * d, size: d * (0.16 + 0.14 * rand()), angle: rand() * 360, tip: 0.4 + 0.6 * rand(), alpha: 0.9, val: 1.0 };",
            "  }",
            "} else if (phase != 3) {",
            "  let tone = 0.8 + 0.12 * noise(dist / d * 0.7) + 0.06 * hash(index);",
            "  emit { x: px, y: py, size: d * (1.0 + 0.05 * noise(dist / d * 2.3 + 5)), angle: h + (noise(dist / d * 0.9 + 11) - 0.5) * 14, tip: 0.92, alpha: 0.97, val: tone };",
            "  if (slack > 1.1 && cl <= 0) {",
            "    slack = rand() * 0.4;",
            "    let off = rands() * 0.2 * d;",
            "    cxp = px + nx * off;",
            "    cyp = py + ny * off;",
            "    ca = h + 90 + rands() * 32;",
            "    cl = d * (0.45 + 0.45 * rand());",
            "    cw = wet;",
            "    cd = dist;",
            "  }",
            "}",
            "// a crease is drawn once the sheet laid after it no longer covers it",
            "if (cl > 0 && (dist - cd > d * 1.3 || phase == 3)) {",
            "  let ux = cos(ca - 90);",
            "  let uy = sin(ca - 90);",
            "  let vx = cos(ca);",
            "  let vy = sin(ca);",
            "  for i in 0..10 {",
            "    let t = (i / 9 - 0.5) * cl;",
            "    let wob = (noise(i * 0.4 + cd) - 0.5) * 0.08 * d;",
            "    let fx = cxp + vx * t + ux * wob;",
            "    let fy = cyp + vy * t + uy * wob;",
            "    let fade = 1 - abs(i / 9 - 0.5) * 1.4;",
            "    emit { x: fx - ux * 0.03 * d, y: fy - uy * 0.03 * d, size: d * 0.075, angle: ca, tip: 1, alpha: 0.8 * fade, val: 0.38 };",
            "    emit { x: fx + ux * 0.045 * d, y: fy + uy * 0.045 * d, size: d * 0.06, angle: ca, tip: 1, alpha: 0.7 * fade, val: 1.0 };",
            "  }",
            "  cl = 0;",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/stencil-edge.png",
      "tags": [
        "stencil",
        "spray",
        "hard edge"
      ],
      "params": {
        "name": "Stencil Edge",
        "spacing": 0.12,
        "opacity": 1,
        "hardness": 1,
        "buildUp": true,
        "program": {
          "state": {
            "pend": 0,
            "d0v": 0,
            "d0x": 0,
            "d0y": 0,
            "d0w": 0,
            "d0a": 0,
            "d1v": 0,
            "d1x": 0,
            "d1y": 0,
            "d1w": 0,
            "d1a": 0,
            "hd": 0
          },
          "step": [
            "let pxcm = diameter / 3.0;",
            "let press = clamp(pressure, 0, 1);",
            "let far = 1 - press;",
            "let rcm = 1.5 * (0.8 + 0.5 * far);",
            "let rpx = rcm * pxcm;",
            "let dts = dt / 1000;",
            "hide = 1;",
            "if (phase == 0) { hd = heading; }",
            "if (phase == 1) {",
            "  let dd = mod(heading - hd + 540, 360) - 180;",
            "  hd += dd * 0.5;",
            "}",
            "let cx = cos(hd);",
            "let sx = sin(hd);",
            "let nx = sx;",
            "let ny = -cx;",
            "let vol = 0;",
            "if (phase != 3) {",
            "  vol = 1.1 * (0.82 * (1 - 0.35 * far)) * dts + (phase == 0 ? 0.01 : 0);",
            "}",
            "let dh = 30000 * vol / (PI * rcm * rcm);",
            "if (dh > 0.01) {",
            "  // the fan lands on the open side only; the stencil card catches the rest",
            "  let ox = px + nx * rpx * 0.5;",
            "  let oy = py + ny * rpx * 0.5;",
            "  let rl = max(rpx * 0.9, 9);",
            "  spray(ox, oy, rl, dh * 1.6 * rpx * rpx * 0.81 / (rl * rl));",
            "  let cover = 1 - exp(-dh / 28);",
            "  emit { x: px, y: py, size: 2 * rpx, alpha: cover, angle: hd, tip: 1 };",
            "  // mist past the fan, open side only",
            "  let nm = 260 * dts * (0.5 + far);",
            "  let k = floor(nm) + gate(1 - fract(nm), rand());",
            "  for i in 0..24 {",
            "    if (i < k) {",
            "      let u = rand();",
            "      let rr = rpx * (0.85 + 0.55 * u * u);",
            "      let a = rand() * 180;",
            "      let ex = cos(a) * rr;",
            "      let ey = sin(a) * rr;",
            "      emit { x: px - cx * ex + nx * ey, y: py - sx * ex + ny * ey, size: max(1.2, pxcm * (0.025 + 0.05 * pow(rand(), 3))), alpha: 0.4 + 0.5 * rand(), angle: 0, tip: 1, hard: 1 };",
            "    }",
            "  }",
            "  // bleed: wet film at the edge wicks under the card, a fringe that grows with the wet",
            "  let edge = wetAt(px + nx * 0.25 * rpx, py + ny * 0.25 * rpx, max(rpx * 0.3, 9));",
            "  let b = smoothstep(60, 520, edge);",
            "  if (b > 0.02) {",
            "    for j in 0..3 {",
            "      let s = (j + 1) / 3;",
            "      let o = b * s * 0.11 * diameter + 0.3;",
            "      emit { x: px - nx * o, y: py - ny * o, size: 2 * rpx * 0.96, alpha: cover * b * (0.55 - 0.15 * j), angle: hd, tip: 1 };",
            "    }",
            "  }",
            "  let film = wetAt(ox, oy, max(rpx * 0.5, 9));",
            "  let pour = film - 420;",
            "  if (pour > 0) {",
            "    let rel = pour * 0.35;",
            "    drain(ox, oy, max(rpx * 0.5, 9), rel);",
            "    let rc = 0.5 * rcm;",
            "    pend = min(0.4, pend + rel * 0.0001 * PI * rc * rc / 3);",
            "  }",
            "}",
            "",
            "if (phase != 3) {",
            "  if (d0v <= 0) {",
            "    if (pend >= 0.008) {",
            "      d0v = pend;",
            "      pend = 0;",
            "      d0x = px + (hash2(index, 0) - 0.5) * 0.8 * rpx + nx * rpx * 0.5;",
            "      d0y = py + 0.35 * rpx;",
            "      d0w = clamp(0.25 + 1.1 * sqrt(d0v), 0.25, 0.7);",
            "      d0a = 0;",
            "    }",
            "  }",
            "}",
            "",
            "if (phase != 3) {",
            "  if (d1v <= 0) {",
            "    if (pend >= 0.008) {",
            "      d1v = pend;",
            "      pend = 0;",
            "      d1x = px + (hash2(index, 1) - 0.5) * 0.8 * rpx + nx * rpx * 0.5;",
            "      d1y = py + 0.35 * rpx;",
            "      d1w = clamp(0.25 + 1.1 * sqrt(d1v), 0.25, 0.7);",
            "      d1a = 0;",
            "    }",
            "  }",
            "}",
            "let reps = 1;",
            "if (phase == 3) { reps = 12; }",
            "let dtr = dts;",
            "if (phase == 3) { dtr = 1.0; }",
            "for c in 0..12 {",
            "  if (c < reps) {",
            "",
            "    if (d0v > 0) {",
            "      d0a = d0a + dtr;",
            "      let sp0 = 3.5 * exp(-d0a / 9.0) * clamp(sqrt(d0v / 0.05), 0.6, 1.7);",
            "      let adv0 = sp0 * dtr;",
            "      let need0 = d0w * 0.012;",
            "      if (adv0 * need0 > d0v) { adv0 = d0v / need0; }",
            "      let y00 = d0y;",
            "      let y10 = y00 + adv0 * pxcm;",
            "      d0v = d0v - adv0 * need0;",
            "      let len0 = (y10 - y00) + d0w * pxcm;",
            "      if (y10 > y00) {",
            "        emit { x: d0x + (noise((y00 + y10) * 0.006 + 0.0) - 0.5) * 0.4 * pxcm, y: (y00 + y10) * 0.5, size: len0 * 1.0, tip: clamp(d0w * pxcm / len0, 0.05, 1), angle: 90, alpha: 0.95, hue: 0, sat: 1, val: 1 };",
            "      }",
            "      d0y = y10;",
            "      if (d0v <= 0.0000001 || sp0 < 0.04) {",
            "        emit { x: d0x + (noise(y10 * 0.006 + 0.0) - 0.5) * 0.4 * pxcm, y: y10 + 0.2 * d0w * pxcm, size: d0w * pxcm * 1.45 * 1.0, alpha: 0.97, angle: 0, tip: 1, val: 1 };",
            "        d0v = 0;",
            "      }",
            "    }",
            "",
            "    if (d1v > 0) {",
            "      d1a = d1a + dtr;",
            "      let sp1 = 3.5 * exp(-d1a / 9.0) * clamp(sqrt(d1v / 0.05), 0.6, 1.7);",
            "      let adv1 = sp1 * dtr;",
            "      let need1 = d1w * 0.012;",
            "      if (adv1 * need1 > d1v) { adv1 = d1v / need1; }",
            "      let y01 = d1y;",
            "      let y11 = y01 + adv1 * pxcm;",
            "      d1v = d1v - adv1 * need1;",
            "      let len1 = (y11 - y01) + d1w * pxcm;",
            "      if (y11 > y01) {",
            "        emit { x: d1x + (noise((y01 + y11) * 0.006 + 9.1) - 0.5) * 0.4 * pxcm, y: (y01 + y11) * 0.5, size: len1 * 1.0, tip: clamp(d1w * pxcm / len1, 0.05, 1), angle: 90, alpha: 0.95, hue: 0, sat: 1, val: 1 };",
            "      }",
            "      d1y = y11;",
            "      if (d1v <= 0.0000001 || sp1 < 0.04) {",
            "        emit { x: d1x + (noise(y11 * 0.006 + 9.1) - 0.5) * 0.4 * pxcm, y: y11 + 0.2 * d1w * pxcm, size: d1w * pxcm * 1.45 * 1.0, alpha: 0.97, angle: 0, tip: 1, val: 1 };",
            "        d1v = 0;",
            "      }",
            "    }",
            "  }",
            "}"
          ],
          "tickMs": 16
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/lap-roller.png",
      "tags": [
        "roller",
        "buff",
        "fill"
      ],
      "params": {
        "name": "Lap Roller",
        "spacing": 0.05,
        "opacity": 1,
        "hardness": 1,
        "program": {
          "state": {
            "load": 1
          },
          "step": [
            "let d = diameter;",
            "let press = clamp(pressure, 0, 1);",
            "let W = d * (0.9 + 0.1 * press);",
            "let h = heading;",
            "let cx = cos(h);",
            "let sx = sin(h);",
            "let nx = -sx;",
            "let ny = cx;",
            "hide = 1;",
            "if (index == 0) { load = 1; }",
            "let lw = W / 8;",
            "// capacity per width grows slower than the width: a small roller still covers some ground",
            "let spend = stepPx / (0.5 * d + 13) * 0.024 * (0.6 + 0.8 * press);",
            "load = max(0, load - spend);",
            "let sup = load * (0.75 + 0.5 * press);",
            "let first = (index < 3) ? 1 : 0;",
            "let probe = max(d * 0.35, 18);",
            "let kov = 1;",
            "for i in 0..8 {",
            "  let off = ((i + 0.5) / 8 - 0.5) * W;",
            "  let lx = px + nx * off;",
            "  let ly = py + ny * off;",
            "  let nap = noise2(i * 1.7 + 3, dist / d * 1.3);",
            "  let streak = smoothstep(0.08, 0.5, sup * (0.45 + 1.1 * nap));",
            "  let wet = wetAt(lx + cx * probe, ly + sx * probe, lw * 0.6);",
            "  let lap = smoothstep(35, 110, wet) * smoothstep(0.1, 0.35, sup);",
            "  let a = min((0.12 + 0.6 * streak) * (0.85 + 0.15 * nap) + first * 0.3, 0.97);",
            "  let a1 = 1 - pow(1 - a, 1 / kov);",
            "  emit { x: lx, y: ly, size: lw * 1.35, tip: 1, angle: h, alpha: a1, val: 1 - 0.2 * lap };",
            "  if (lap > 0.05) {",
            "    emit { x: lx, y: ly, size: lw * 1.3, tip: 1, angle: h, alpha: 1 - pow(1 - 0.4 * lap, 1 / kov), val: 0.62 };",
            "  }",
            "  spray(lx, ly, lw * 0.9 + 4, 80 * streak * stepPx / d * 3);",
            "}",
            "if (sup > 0.35 && index > 3) {",
            "  let t = smoothstep(0.35, 0.9, sup) * 0.55;",
            "  emit { x: px + nx * W * 0.5, y: py + ny * W * 0.5, size: lw * 0.9, tip: 0.4, angle: h, alpha: 1 - pow(1 - t, 1 / kov), val: 1 };",
            "  emit { x: px - nx * W * 0.5, y: py - ny * W * 0.5, size: lw * 0.9, tip: 0.4, angle: h, alpha: 1 - pow(1 - t, 1 / kov), val: 1 };",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/valve-marker.png",
      "tags": [
        "marker",
        "paint marker",
        "tag",
        "drip"
      ],
      "params": {
        "name": "Valve Marker",
        "spacing": 0.12,
        "opacity": 1,
        "hardness": 1,
        "buildUp": true,
        "program": {
          "state": {
            "pend": 0,
            "d0v": 0,
            "d0x": 0,
            "d0y": 0,
            "d0w": 0,
            "d0a": 0,
            "d1v": 0,
            "d1x": 0,
            "d1y": 0,
            "d1w": 0,
            "d1a": 0,
            "nib": 0.7
          },
          "step": [
            "let pxcm = diameter / 0.8;",
            "let press = clamp(pressure, 0, 1);",
            "let rcm = 0.4 * (0.85 + 0.15 * press);",
            "let rpx = rcm * pxcm;",
            "let dts = dt / 1000;",
            "hide = 1;",
            "if (index == 0) { nib = 0.7; }",
            "// pump: pressing hard while the pen is held or creeping opens the valve",
            "let pump = (0.35 + 0.65 * smoothstep(0.3, 0.9, press)) * ((phase == 2 && layerSpeed < 0.02) ? 1 : 0);",
            "if (phase == 0) { nib += 0.25 * smoothstep(0.4, 0.9, press); }",
            "if (phase != 3) { nib += 1.4 * pump * dts; }",
            "let over = max(0, nib - 1);",
            "nib = min(nib, 1);",
            "let stepcm = stepPx / pxcm;",
            "let want = 0;",
            "if (phase == 1) { want = stepPx / (0.5 * diameter + 13) * 0.8 * 0.08; }",
            "let lay = min(nib, want) + over * 0.6;",
            "nib = max(0, nib - want);",
            "let lf = lay * 0.004 / (2 * rcm * max(stepcm, 0.05)) * 10000 + over * 600;",
            "if (phase != 3) {",
            "  let full = smoothstep(0.02, 0.35, nib);",
            "  let skip = smoothstep(0.25, 0.6, full * 0.7 + noise(dist / pxcm * 2.5) * 0.6);",
            "  let a = (phase <= 1) ? (0.25 + 0.75 * skip) * smoothstep(0, 0.12, nib + 0.04) : 0;",
            "  if (a > 0.01) {",
            "    emit { x: px, y: py, size: 2 * rpx, alpha: a, angle: heading + 35, tip: 0.8, val: 0.88 + 0.12 * full };",
            "  }",
            "  let rl = max(rpx, 9);",
            "  if (lf > 1) { spray(px, py, rl, lf * rpx * rpx / (rl * rl)); }",
            "  if (over > 0) {",
            "    emit { x: px, y: py, size: 2 * rpx * (1.3 + 3 * over), alpha: 0.9, angle: 0, tip: 1 };",
            "  }",
            "",
            "  let film = wetAt(px, py, max(rpx * 0.6, 9));",
            "  let pour = film - 380;",
            "  if (pour > 0) {",
            "    let rel = pour * 0.4;",
            "    drain(px, py, max(rpx * 0.6, 9), rel);",
            "    let rc = 0.6 * rcm;",
            "    pend = min(0.4, pend + rel * 0.0001 * PI * rc * rc / 3);",
            "  }",
            "}",
            "",
            "if (phase != 3) {",
            "  if (d0v <= 0) {",
            "    if (pend >= 0.003) {",
            "      d0v = pend;",
            "      pend = 0;",
            "      d0x = px + (hash2(index, 0) - 0.5) * 0.8 * rpx;",
            "      d0y = py + 0.35 * rpx;",
            "      d0w = clamp(0.1 + 0.7 * sqrt(d0v), 0.1, 0.3);",
            "      d0a = 0;",
            "    }",
            "  }",
            "}",
            "",
            "if (phase != 3) {",
            "  if (d1v <= 0) {",
            "    if (pend >= 0.003) {",
            "      d1v = pend;",
            "      pend = 0;",
            "      d1x = px + (hash2(index, 1) - 0.5) * 0.8 * rpx;",
            "      d1y = py + 0.35 * rpx;",
            "      d1w = clamp(0.1 + 0.7 * sqrt(d1v), 0.1, 0.3);",
            "      d1a = 0;",
            "    }",
            "  }",
            "}",
            "let reps = 1;",
            "if (phase == 3) { reps = 12; }",
            "let dtr = dts;",
            "if (phase == 3) { dtr = 1.0; }",
            "for c in 0..12 {",
            "  if (c < reps) {",
            "",
            "    if (d0v > 0) {",
            "      d0a = d0a + dtr;",
            "      let sp0 = 2.6 * exp(-d0a / 7.0) * clamp(sqrt(d0v / 0.05), 0.6, 1.7);",
            "      let adv0 = sp0 * dtr;",
            "      let need0 = d0w * 0.014;",
            "      if (adv0 * need0 > d0v) { adv0 = d0v / need0; }",
            "      let y00 = d0y;",
            "      let y10 = y00 + adv0 * pxcm;",
            "      d0v = d0v - adv0 * need0;",
            "      let len0 = (y10 - y00) + d0w * pxcm;",
            "      if (y10 > y00) {",
            "        emit { x: d0x + (noise((y00 + y10) * 0.006 + 0.0) - 0.5) * 0.4 * pxcm, y: (y00 + y10) * 0.5, size: len0 * 1.0, tip: clamp(d0w * pxcm / len0, 0.05, 1), angle: 90, alpha: 0.95, hue: 0, sat: 1, val: 1 };",
            "      }",
            "      d0y = y10;",
            "      if (d0v <= 0.0000001 || sp0 < 0.04) {",
            "        emit { x: d0x + (noise(y10 * 0.006 + 0.0) - 0.5) * 0.4 * pxcm, y: y10 + 0.2 * d0w * pxcm, size: d0w * pxcm * 1.45 * 1.0, alpha: 0.97, angle: 0, tip: 1, val: 1 };",
            "        d0v = 0;",
            "      }",
            "    }",
            "",
            "    if (d1v > 0) {",
            "      d1a = d1a + dtr;",
            "      let sp1 = 2.6 * exp(-d1a / 7.0) * clamp(sqrt(d1v / 0.05), 0.6, 1.7);",
            "      let adv1 = sp1 * dtr;",
            "      let need1 = d1w * 0.014;",
            "      if (adv1 * need1 > d1v) { adv1 = d1v / need1; }",
            "      let y01 = d1y;",
            "      let y11 = y01 + adv1 * pxcm;",
            "      d1v = d1v - adv1 * need1;",
            "      let len1 = (y11 - y01) + d1w * pxcm;",
            "      if (y11 > y01) {",
            "        emit { x: d1x + (noise((y01 + y11) * 0.006 + 9.1) - 0.5) * 0.4 * pxcm, y: (y01 + y11) * 0.5, size: len1 * 1.0, tip: clamp(d1w * pxcm / len1, 0.05, 1), angle: 90, alpha: 0.95, hue: 0, sat: 1, val: 1 };",
            "      }",
            "      d1y = y11;",
            "      if (d1v <= 0.0000001 || sp1 < 0.04) {",
            "        emit { x: d1x + (noise(y11 * 0.006 + 9.1) - 0.5) * 0.4 * pxcm, y: y11 + 0.2 * d1w * pxcm, size: d1w * pxcm * 1.45 * 1.0, alpha: 0.97, angle: 0, tip: 1, val: 1 };",
            "        d1v = 0;",
            "      }",
            "    }",
            "  }",
            "}"
          ],
          "tickMs": 16
        }
      }
    }
  ]
}
