{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.kinetic.voltage",
  "name": "Voltage",
  "version": "1.0.0",
  "kind": "asset",
  "license": "LicenseRef-Proprietary",
  "compat": ">=0.1",
  "description": "Five brushes that discharge. A bolt that forks the faster you move, an arc that re-strikes and leaves its ghosts, a coil whose sparks orbit and fly off, a fuzz of charged hairs that bristle at speed, and a frost that only grows if you go slowly.",
  "author": "HereLiesAz",
  "targetApps": [
    "com.hereliesaz.graffux"
  ],
  "preview": {
    "image": "assets/preview.png"
  },
  "assets": [
    {
      "type": "brush",
      "path": "assets/lightning.png",
      "tags": [
        "lightning",
        "electric",
        "branching"
      ],
      "params": {
        "name": "Lightning",
        "spacing": 0.1,
        "opacity": 1,
        "program": {
          "state": {
            "d0": 26,
            "sd": 0,
            "cx": 0,
            "cy": 0,
            "dx": 1,
            "dy": 0,
            "cool": 0
          },
          "init": [
            "d0 = diameter; cx = px; cy = py; sd = rand() * 97 + 3;"
          ],
          "step": [
            "let pr = clamp(pressure, 0, 1);",
            "let fast = smoothstep(0.3, 3, speed);",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.35); dy = lerp(dy, sin(heading), 0.35);",
            "}",
            "let dl = hypot(dx, dy);",
            "let tx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ty = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = tx; dy = ty;",
            "hide = 1;",
            "// trunk: a zigzag with a lazy meander, jagged by alternating kinks rather than by noise",
            "let uu = dist / (d0 * 0.5);",
            "let k = floor(uu);",
            "let fk = uu - k;",
            "let z0 = (mod(k, 2) * 2 - 1) * (hash(k + sd + 50) < 0.2 ? -1 : 1) * (0.35 + 0.65 * hash(k + sd));",
            "let z1 = (mod(k + 1, 2) * 2 - 1) * (hash(k + sd + 51) < 0.2 ? -1 : 1) * (0.35 + 0.65 * hash(k + 1 + sd));",
            "let env = smoothstep(0, d0 * 0.8, dist);",
            "let off = (lerp(z0, z1, fk) * d0 * (0.15 + 0.2 * fast) + (noise(dist / (d0 * 4) + sd) - 0.5) * d0 * 0.9) * env;",
            "let qx = px - ty * off;",
            "let qy = py + tx * off;",
            "let cw = max(d0 * 0.17 * (0.65 + 0.7 * pr), 2.2);",
            "let flick = 0.84 + 0.16 * noise(dist / (d0 * 0.3) + sd * 3);",
            "if (index == 0) {",
            "  emit { x: px, y: py, size: d0 * 1.3, tip: 1, alpha: 0.2 };",
            "  emit { x: px, y: py, size: d0 * 0.5, tip: 1, alpha: 0.7 };",
            "  emit { x: px, y: py, size: cw * 1.4, tip: 1, alpha: 1 };",
            "} else {",
            "  let ex = qx - cx;",
            "  let ey = qy - cy;",
            "  let sg = hypot(ex, ey);",
            "  if (sg > 0.05) {",
            "    let an = atan2(ey, ex);",
            "    let hw = d0 * (0.5 + 0.35 * pr + 0.2 * fast);",
            "    let mw = cw * 2.4;",
            "    emit { x: (qx + cx) * 0.5, y: (qy + cy) * 0.5, size: sg * 1.7 + hw, tip: hw / (sg * 1.7 + hw), angle: an, alpha: 0.12 + 0.1 * pr };",
            "    emit { x: (qx + cx) * 0.5, y: (qy + cy) * 0.5, size: sg * 1.7 + mw, tip: mw / (sg * 1.7 + mw), angle: an, alpha: 0.5 * flick };",
            "    emit { x: (qx + cx) * 0.5, y: (qy + cy) * 0.5, size: sg * 1.7 + cw, tip: cw / (sg * 1.7 + cw), angle: an, alpha: flick };",
            "  }",
            "}",
            "cx = qx; cy = qy;",
            "// forks: rarer when the hand is slow, frequent when it is flung",
            "cool -= 1;",
            "let nf = 0;",
            "if (index == 0) { nf = 3; } else if (cool <= 0 && rand() < 0.02 + 0.085 * fast + 0.02 * pr) {",
            "  nf = 1 + (rand() < fast * 0.45 ? 1 : 0);",
            "  cool = 3;",
            "}",
            "for q in 0..3 {",
            "    let h = atan2(ty, tx) + (index == 0 ? (q - 1) * 60 + rands() * 14 : (rand() < 0.5 ? -1 : 1) * (16 + 38 * rand()));",
            "    let nb = q < nf ? min(4 + floor(rand() * 3 + fast * 3 + pr * 2), 11) : 0;",
            "    let bl0 = d0 * (0.28 + 0.3 * rand()) * (0.75 + 0.5 * fast + 0.3 * pr);",
            "    let sf = 1 + floor(rand() * 3);",
            "    let bx = qx;",
            "    let by = qy;",
            "    for i in 0..12 {",
            "      if (i < nb) {",
            "        let t = i / nb;",
            "        h += rands() * 58;",
            "        let bl = bl0 * (1 - 0.5 * t) * (0.55 + 0.9 * rand());",
            "        let nx2 = bx + cos(h) * bl;",
            "        let ny2 = by + sin(h) * bl;",
            "        let al = pow(1 - t, 1.15);",
            "        let w = max(cw * (1 - 0.7 * t), 1.1);",
            "        let gw = w * 4.5;",
            "        emit { x: (bx + nx2) * 0.5, y: (by + ny2) * 0.5, size: bl * 1.7 + gw, tip: gw / (bl * 1.7 + gw), angle: h, alpha: 0.11 * al };",
            "        emit { x: (bx + nx2) * 0.5, y: (by + ny2) * 0.5, size: bl * 1.7 + w, tip: w / (bl * 1.7 + w), angle: h, alpha: 0.95 * al };",
            "        let sh = h + (rand() < 0.5 ? -1 : 1) * (25 + 30 * rand());",
            "        let ns = 2 + floor(rand() * 3);",
            "        let sx = nx2;",
            "        let sy = ny2;",
            "        for j in 0..4 {",
            "          if (i == sf && nb > 4 && j < ns) {",
            "            let tj = j / ns;",
            "            sh += rands() * 60;",
            "            let sl = bl0 * 0.6 * (1 - 0.5 * tj) * (0.6 + 0.8 * rand());",
            "            let sx2 = sx + cos(sh) * sl;",
            "            let sy2 = sy + sin(sh) * sl;",
            "            let sw = max(w * 0.8 * (1 - 0.6 * tj), 1);",
            "            emit { x: (sx + sx2) * 0.5, y: (sy + sy2) * 0.5, size: sl * 1.7 + sw, tip: sw / (sl * 1.7 + sw), angle: sh, alpha: 0.8 * al * (1 - tj) };",
            "            sx = sx2; sy = sy2;",
            "          }",
            "        }",
            "        bx = nx2; by = ny2;",
            "      }",
            "    }",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/arc.png",
      "tags": [
        "arc",
        "electric",
        "crackle"
      ],
      "params": {
        "name": "Arc",
        "spacing": 0.1,
        "opacity": 1,
        "program": {
          "state": {
            "d0": 26,
            "sd": 0,
            "dx": 1,
            "dy": 0,
            "pd": 0,
            "ppx": 0,
            "ppy": 0,
            "ptx": 1,
            "pty": 0,
            "lx": 0,
            "ly": 0,
            "lsm": 0
          },
          "init": [
            "d0 = diameter; sd = rand() * 61 + 2; ppx = px; ppy = py; lx = px; ly = py;"
          ],
          "step": [
            "let pr = clamp(pressure, 0, 1);",
            "let fast = smoothstep(0.3, 3, speed);",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.35); dy = lerp(dy, sin(heading), 0.35);",
            "}",
            "let dl = hypot(dx, dy);",
            "let tx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ty = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = tx; dy = ty;",
            "hide = 1;",
            "let cw = 1 + d0 * 0.05 * (0.6 + 0.8 * pr);",
            "let env = smoothstep(0, d0 * 0.6, dist);",
            "let sm0 = floor(time / 240 + dist / (d0 * 3) + hash(sd) * 5);",
            "if (index == 0) {",
            "  emit { x: px, y: py, size: cw * 3, tip: 1, alpha: 1 };",
            "  lsm = sm0;",
            "} else {",
            "  for m in 0..3 {",
            "    let um = time / (240 + 110 * m) + dist / (d0 * (3 + 1.3 * m)) + hash(m + sd) * 5;",
            "    let sm = floor(um);",
            "    let bs = sm * 7.31 + m * 113.7 + sd;",
            "    let slm = 4 + d0 * (0.36 + 0.1 * m);",
            "    let am = d0 * (0.28 + 0.14 * m) * (0.8 + 0.5 * fast) * env;",
            "    let ua = dist / slm;",
            "    let ka = floor(ua);",
            "    let za = lerp((mod(ka, 2) * 2 - 1) * (hash(ka + bs + 40) < 0.25 ? -1 : 1) * (0.15 + 0.85 * hash(ka + bs)), (mod(ka + 1, 2) * 2 - 1) * (hash(ka + 1 + bs + 40) < 0.25 ? -1 : 1) * (0.15 + 0.85 * hash(ka + 1 + bs)), ua - ka);",
            "    let ub = pd / slm;",
            "    let kb = floor(ub);",
            "    let zb = lerp((mod(kb, 2) * 2 - 1) * (hash(kb + bs + 40) < 0.25 ? -1 : 1) * (0.15 + 0.85 * hash(kb + bs)), (mod(kb + 1, 2) * 2 - 1) * (hash(kb + 1 + bs + 40) < 0.25 ? -1 : 1) * (0.15 + 0.85 * hash(kb + 1 + bs)), ub - kb);",
            "    let ax = px - ty * za * am;",
            "    let ay = py + tx * za * am;",
            "    let bx = ppx - pty * zb * am;",
            "    let by = ppy + ptx * zb * am;",
            "    let ex = ax - bx;",
            "    let ey = ay - by;",
            "    let sg = hypot(ex, ey);",
            "    let vis = m == 0 ? 1 : (hash(sm * 3.7 + m * 19 + sd) > 0.22 ? 1 : 0.15);",
            "    let w = cw * (1 - 0.15 * m);",
            "    let al = (m == 0 ? 1 : (m == 1 ? 0.62 : 0.36)) * vis;",
            "    if (sg > 0.05) {",
            "      emit { x: (ax + bx) * 0.5, y: (ay + by) * 0.5, size: sg * 1.3 + w, tip: w / (sg * 1.3 + w), angle: atan2(ey, ex), alpha: al };",
            "    }",
            "    if (m == 0) {",
            "      if (sm != lsm) {",
            "        // re-strike: the old path jumps to the new one and flashes",
            "        let jx = bx - lx;",
            "        let jy = by - ly;",
            "        let jl = hypot(jx, jy);",
            "        if (jl > 0.3) { emit { x: (bx + lx) * 0.5, y: (by + ly) * 0.5, size: jl * 1.2 + w, tip: w / (jl * 1.2 + w), angle: atan2(jy, jx), alpha: 0.85 }; }",
            "        emit { x: bx, y: by, size: w * 1.25, tip: 1, alpha: 1 };",
            "        lsm = sm;",
            "      }",
            "      lx = ax; ly = ay;",
            "    }",
            "  }",
            "}",
            "pd = dist; ppx = px; ppy = py; ptx = tx; pty = ty;"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/coil.png",
      "tags": [
        "spark",
        "filament",
        "glow"
      ],
      "params": {
        "name": "Coil",
        "spacing": 0.05,
        "opacity": 1,
        "program": {
          "state": {
            "d0": 26,
            "sd": 0,
            "dx": 1,
            "dy": 0,
            "pd": 0,
            "ppx": 0,
            "ppy": 0,
            "pnx": 0,
            "pny": 1
          },
          "init": [
            "d0 = diameter; sd = rand() * 71 + 2; ppx = px; ppy = py;"
          ],
          "step": [
            "let pr = clamp(pressure, 0, 1);",
            "let fast = smoothstep(0.3, 3, speed);",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.35); dy = lerp(dy, sin(heading), 0.35);",
            "}",
            "let dl = hypot(dx, dy);",
            "let tx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ty = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = tx; dy = ty;",
            "let nx = -ty;",
            "let ny = tx;",
            "hide = 1;",
            "let rc = d0 * (0.2 + 0.1 * pr);",
            "let pc = d0 * (0.72 - 0.22 * pr);",
            "let w = 1.1 + d0 * 0.045;",
            "let fl = 0.88 + 0.12 * noise(dist / (d0 * 0.25) + sd);",
            "let ex = px - ppx;",
            "let ey = py - ppy;",
            "let sg = hypot(ex, ey);",
            "let an = atan2(ey, ex);",
            "if (index > 0 && sg > 0.05) {",
            "  let gw = d0 * 0.4;",
            "  emit { x: (px + ppx) * 0.5, y: (py + ppy) * 0.5, size: sg * 1.7 + gw, tip: gw / (sg * 1.7 + gw), angle: an, alpha: 0.1 + 0.05 * pr };",
            "  emit { x: (px + ppx) * 0.5, y: (py + ppy) * 0.5, size: sg * 1.7 + w * 2.2, tip: w * 2.2 / (sg * 1.7 + w * 2.2), angle: an, alpha: fl };",
            "  // the wound wire: two strands in antiphase, the near one bright and fat",
            "  for s in 0..2 {",
            "    let pz = dist / pc * 360 + s * 180;",
            "    let pq = pd / pc * 360 + s * 180;",
            "    let dz = 0.5 + 0.5 * cos((pz + pq) * 0.5);",
            "    let o1 = rc * sin(pz);",
            "    let o0 = rc * sin(pq);",
            "    let ax = px + nx * o1;",
            "    let ay = py + ny * o1;",
            "    let bx = ppx + pnx * o0;",
            "    let by = ppy + pny * o0;",
            "    let sl = hypot(ax - bx, ay - by);",
            "    let ww = w * (1 + 0.8 * dz);",
            "    emit { x: (ax + bx) * 0.5, y: (ay + by) * 0.5, size: sl * 1.7 + ww, tip: ww / (sl * 1.7 + ww), angle: atan2(ay - by, ax - bx), alpha: 0.35 + 0.65 * dz };",
            "  }",
            "}",
            "// orbiting sparks: charge builds along the orbit and each one is flung off along its tangent",
            "let nsp = 1 + floor(pr * pr * 2.99);",
            "for i in 0..3 {",
            "  if (i < nsp) {",
            "    let pi2 = pc * (0.9 + 0.3 * i);",
            "    let ri = rc * (1.5 + 0.3 * i);",
            "    let ph0 = i * 120 + hash(i + sd) * 360;",
            "    let phi = dist / pi2 * 360 + ph0;",
            "    let li = d0 * (2 + 0.7 * i);",
            "    let duty = 0.3 + 0.15 * pr;",
            "    let uc = dist / li + hash(i + 7 + sd);",
            "    let fc = uc - floor(uc);",
            "    let up = pd / li + hash(i + 7 + sd);",
            "    let fp = up - floor(up);",
            "    let od = ri * sin(phi);",
            "    let ox = px + nx * od;",
            "    let oy = py + ny * od;",
            "    if (fc < duty && index > 0 && fp < fc) {",
            "      let e = fc / duty;",
            "      let o0 = ri * sin(pd / pi2 * 360 + ph0);",
            "      let bx = ppx + pnx * o0;",
            "      let by = ppy + pny * o0;",
            "      let sl = hypot(ox - bx, oy - by);",
            "      let cw = (0.7 + d0 * (0.045 + 0.07 * pr)) * (0.4 + 0.9 * e);",
            "      emit { x: (ox + bx) * 0.5, y: (oy + by) * 0.5, size: sl * 1.7 + cw, tip: cw / (sl * 1.7 + cw), angle: atan2(oy - by, ox - bx), alpha: 0.3 + 0.7 * pow(e, 1.2) };",
            "    }",
            "    if (index > 0 && fp < duty && fc >= duty && floor(up) == floor(uc)) {",
            "      let fd = heading + atan2(ri * cos(phi) * 6.2832 / pi2, 1) + rands() * 8;",
            "      let lf = d0 * (0.5 + 0.9 * fast) * (0.6 + 0.7 * rand()) * (0.7 + 0.5 * pr);",
            "      let cf = cos(fd);",
            "      let sf = sin(fd);",
            "      emit { x: ox + cf * lf * 0.5, y: oy + sf * lf * 0.5, size: lf, tip: 0.12, angle: fd, alpha: 0.75 };",
            "      emit { x: ox, y: oy, size: d0 * (0.2 + 0.14 * pr), tip: 1, alpha: 1 };",
            "      for b in 0..3 {",
            "        let tb = 0.8 + 0.4 * b;",
            "        emit { x: ox + cf * lf * tb, y: oy + sf * lf * tb, size: 0.6 + d0 * 0.07 * (1 - 0.3 * b), tip: 1, alpha: 0.9 - 0.25 * b };",
            "      }",
            "    }",
            "  }",
            "}",
            "if (index == 0) {",
            "  for r in 0..8 {",
            "    let ar = r * 45 + rands() * 14;",
            "    let lr = d0 * (0.45 + 0.5 * rand());",
            "    emit { x: px + cos(ar) * lr * 0.5, y: py + sin(ar) * lr * 0.5, size: lr, tip: 0.12, angle: ar, alpha: 0.8 };",
            "    emit { x: px + cos(ar) * lr * 0.95, y: py + sin(ar) * lr * 0.95, size: 0.6 + d0 * 0.07, tip: 1, alpha: 1 };",
            "  }",
            "  emit { x: px, y: py, size: d0 * 0.4, tip: 1, alpha: 1 };",
            "}",
            "pd = dist; ppx = px; ppy = py; pnx = nx; pny = ny;"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/static.png",
      "tags": [
        "hair",
        "fuzz",
        "charge"
      ],
      "params": {
        "name": "Static",
        "spacing": 0.12,
        "opacity": 1,
        "program": {
          "state": {
            "d0": 26,
            "sd": 0,
            "dx": 1,
            "dy": 0,
            "bri": 0
          },
          "init": [
            "d0 = diameter; sd = rand() * 83 + 2;"
          ],
          "step": [
            "let pr = clamp(pressure, 0, 1);",
            "let fast = smoothstep(0.25, 2.6, speed);",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.35); dy = lerp(dy, sin(heading), 0.35);",
            "}",
            "let dl = hypot(dx, dy);",
            "let tx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ty = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = tx; dy = ty;",
            "hide = 1;",
            "// bristle: fast hands and sharp turns stand the hairs up, a slow hand lets them lie down",
            "let tg = clamp(fast * 1.1 + abs(turn) / 150, 0, 1);",
            "if (index == 0) { bri = tg; } else { bri = lerp(bri, tg, 0.22); }",
            "let sw = max(d0 * 0.03, 0.9);",
            "if (index > 0) {",
            "  emit { x: px, y: py, size: stepPx * 3 + 2, tip: clamp(sw * 1.4 / (stepPx * 3 + 2), 0.05, 1), angle: heading, alpha: 0.55 };",
            "}",
            "let nh = 2 + (fast > 0.5 ? 1 : 0) + (d0 > 40 ? 1 : 0);",
            "let lie = (1 - bri) * 56;",
            "for j in 0..16 {",
            "  let sd2 = mod(j, 2) * 2 - 1;",
            "  if (index == 0 ? 1 : j < nh * 2) {",
            "    let h1 = hash(index * 17 + j * 3.7 + sd);",
            "    let h2 = hash(index * 13 + j * 7.1 + sd + 9);",
            "    let h3 = hash(index * 11 + j * 5.3 + sd + 21);",
            "    let ba = index == 0 ? j * 22.5 + h1 * 20 : heading + sd2 * (90 - lie * (0.6 + 0.4 * h2) + 12 * bri + (h3 - 0.5) * 20 + (noise(dist / (d0 * 0.9) + sd) - 0.5) * 60 * bri);",
            "    let lh = d0 * (0.36 + 0.6 * bri) * (0.45 + 0.8 * h1) * (index == 0 ? 1.5 : 1) * (0.85 + 0.3 * pr);",
            "    let rt = index == 0 ? 0 : (h3 - 0.5) * stepPx;",
            "    let rf = index == 0 ? 0 : (h2 - 0.5) * d0 * 0.06;",
            "    let rx = px + tx * rt - ty * rf;",
            "    let ry = py + ty * rt + tx * rf;",
            "    let bend = (h3 < 0.5 ? -1 : 1) * 70 * (1 - 0.88 * pr) * (0.4 + 0.6 * h2);",
            "    let a1 = ba + bend * 0.25;",
            "    let a2 = ba + bend * 0.8;",
            "    let l1 = lh * 0.55;",
            "    let l2 = lh * 0.5;",
            "    let wh = max(d0 * 0.046, 1.1) * (0.7 + 0.5 * h1);",
            "    let al = (0.55 + 0.4 * h2) * (0.8 + 0.2 * pr);",
            "    let e1x = rx + cos(a1) * l1;",
            "    let e1y = ry + sin(a1) * l1;",
            "    emit { x: rx + cos(a1) * l1 * 0.55, y: ry + sin(a1) * l1 * 0.55, size: l1 * 1.2, tip: clamp(wh / (l1 * 1.2), 0.05, 1), angle: a1, alpha: al };",
            "    emit { x: e1x + cos(a2) * l2 * 0.5, y: e1y + sin(a2) * l2 * 0.5, size: l2 * 1.15, tip: clamp(wh * 0.62 / (l2 * 1.15), 0.05, 1), angle: a2, alpha: al * 0.9 };",
            "  }",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/frost.png",
      "tags": [
        "frost",
        "crystal",
        "ice"
      ],
      "params": {
        "name": "Frost",
        "spacing": 0.1,
        "opacity": 1,
        "program": {
          "state": {
            "d0": 26,
            "sd": 0,
            "dx": 1,
            "dy": 0,
            "nxt": 0,
            "cnt": 0
          },
          "init": [
            "d0 = diameter; sd = rand() * 79 + 2;"
          ],
          "step": [
            "let pr = clamp(pressure, 0, 1);",
            "let slow = 1 - smoothstep(0.1, 2.2, speed);",
            "if (index <= 1) { dx = cos(heading); dy = sin(heading); } else {",
            "  dx = lerp(dx, cos(heading), 0.35); dy = lerp(dy, sin(heading), 0.35);",
            "}",
            "let dl = hypot(dx, dy);",
            "let tx = dl > 0.001 ? dx / dl : cos(heading);",
            "let ty = dl > 0.001 ? dy / dl : sin(heading);",
            "dx = tx; dy = ty;",
            "hide = 1;",
            "// growth: careful strokes feed the crystals",
            "let g = clamp(0.15 + 0.9 * slow, 0, 1.05);",
            "let wa = max(d0 * 0.05 * (0.7 + 0.6 * pr), 1.05);",
            "if (index > 0) {",
            "  emit { x: px, y: py, size: stepPx * 2.8 + 2, tip: clamp(wa * 1.1 / (stepPx * 2.8 + 2), 0.05, 1), angle: heading, alpha: 0.8 };",
            "  let sb = mod(index, 2) * 2 - 1;",
            "  let lb = d0 * 0.15 * (0.5 + hash(index + sd));",
            "  let ab = heading + sb * 52;",
            "  emit { x: px + cos(ab) * lb * 0.5, y: py + sin(ab) * lb * 0.5, size: lb, tip: clamp(wa * 0.8 / lb, 0.05, 1), angle: ab, alpha: 0.6 };",
            "}",
            "if (dist >= nxt) {",
            "  nxt = dist + d0 * (0.85 + 0.5 * g) * (0.85 + 0.3 * rand());",
            "  cnt += 1;",
            "  let base = heading + 90 + (hash(cnt + sd) - 0.5) * 40;",
            "  emit { x: px, y: py, size: d0 * 0.13, tip: 1, alpha: 1 };",
            "  for j in 0..6 {",
            "    let aj = base + 60 * j + (hash(cnt * 7 + j + sd) - 0.5) * 14;",
            "    let la = d0 * (0.22 + 0.9 * g) * (0.65 + 0.55 * hash(cnt * 5 + j * 3.1 + sd + 4)) * (0.8 + 0.3 * pr);",
            "    let ca = cos(aj);",
            "    let sa = sin(aj);",
            "    emit { x: px + ca * la * 0.5, y: py + sa * la * 0.5, size: la, tip: clamp(wa / la, 0.05, 1), angle: aj, alpha: 0.95 };",
            "    for b in 0..3 {",
            "      let t = 0.3 + 0.24 * b;",
            "      let bx = px + ca * la * t;",
            "      let by = py + sa * la * t;",
            "      let lb2 = la * (0.55 * (1 - t) + 0.12) * (0.8 + 0.3 * hash(cnt * 3 + j * 5 + b + sd));",
            "      let al = 0.85 * (1 - 0.7 * t);",
            "      for sg in 0..2 {",
            "        let sn = sg * 2 - 1;",
            "        let cb = ca * 0.5 - sn * sa * 0.866;",
            "        let sbb = sa * 0.5 + sn * ca * 0.866;",
            "        let ab2 = aj + sn * 60;",
            "        emit { x: bx + cb * lb2 * 0.5, y: by + sbb * lb2 * 0.5, size: lb2, tip: clamp(wa * 0.75 / lb2, 0.05, 1), angle: ab2, alpha: al };",
            "        if (g > 0.5 && b < 2) {",
            "          let cx2 = bx + cb * lb2 * 0.55;",
            "          let cy2 = by + sbb * lb2 * 0.55;",
            "          let l3 = lb2 * 0.42;",
            "          for s3 in 0..2 {",
            "            let a3 = ab2 + (s3 * 2 - 1) * 60;",
            "            emit { x: cx2 + cos(a3) * l3 * 0.5, y: cy2 + sin(a3) * l3 * 0.5, size: l3, tip: clamp(wa * 0.6 / l3, 0.05, 1), angle: a3, alpha: al * 0.8 };",
            "          }",
            "        }",
            "      }",
            "    }",
            "  }",
            "}"
          ]
        }
      }
    }
  ]
}
