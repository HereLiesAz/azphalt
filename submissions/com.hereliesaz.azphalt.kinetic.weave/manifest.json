{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.kinetic.weave",
  "name": "Weave",
  "version": "1.0.0",
  "kind": "asset",
  "license": "LicenseRef-Proprietary",
  "compat": ">=0.1",
  "description": "Strands that twist, braid and interlock along your path, with real over and under. A three-strand plait, a two-ply rope that frays at speed, a chain whose links thread through each other, barbed wire that ties a barb every few paces, and a ribbon that flips wherever you turn hard.",
  "author": "HereLiesAz",
  "targetApps": [
    "com.hereliesaz.graffux"
  ],
  "preview": {
    "image": "assets/preview.png"
  },
  "assets": [
    {
      "type": "brush",
      "path": "assets/braid-strand.png",
      "tags": [
        "braid",
        "plait",
        "rope",
        "weave"
      ],
      "params": {
        "name": "Braid",
        "spacing": 0.03,
        "buildUp": true,
        "opacity": 1,
        "dynamics": [
          {
            "sensor": "pressure",
            "parameter": "size",
            "outputMin": 0.55,
            "outputMax": 1
          }
        ],
        "program": {
          "state": {
            "ang": 0,
            "ph": 0,
            "pd": 0
          },
          "step": [
            "hide = 1;",
            "if (index == 0) {",
            "  emit { size: diameter * 0.6, tip: 1, angle: 0, val: 0.25, alpha: 0.92 };",
            "  emit { size: diameter * 0.6, tip: 1, angle: 45, val: 0.25, alpha: 0.92 };",
            "  emit { size: diameter * 0.52, tip: 1, angle: 0, val: 0.95, alpha: 1 };",
            "  emit { size: diameter * 0.52, tip: 1, angle: 45, val: 0.95, alpha: 1 };",
            "} else {",
            "let gm = max(1, 1.6 / stepPx);",
            "gapMul = gm;",
            "let st = stepPx * gm;",
            "if (index <= 1) { ang = heading; }",
            "else { ang += (mod(heading - ang + 540, 360) - 180) * (1 - exp(-st / (diameter * 0.3))); }",
            "let D = diameter;",
            "let w = D * 0.43;",
            "let A = (D - w) * 0.5;",
            "let pitch = D * 3.2;",
            "ph += (dist - pd) / pitch * 360;",
            "pd = dist;",
            "let nx = -sin(ang);",
            "let ny = cos(ang);",
            "let d0 = -sin(2 * ph);",
            "let d1 = -sin(2 * ph + 240);",
            "let d2 = -sin(2 * ph + 480);",
            "let th = min(max(st * 2.4, 1.6), D * 0.2);",
            "for p in 0..3 {",
            "  for k in 0..3 {",
            "    let a = ph + k * 120;",
            "    let dk = -sin(2 * a);",
            "    let rk = (d0 < dk ? 1 : 0) + (d1 < dk ? 1 : 0) + (d2 < dk ? 1 : 0);",
            "    if (rk == p) {",
            "      let o = A * sin(a);",
            "      let ex = px + nx * o;",
            "      let ey = py + ny * o;",
            "      let lit = 0.5 + 0.5 * dk;",
            "      emit { x: ex, y: ey, size: w * 1.22, tip: min(1, th / (w * 1.22)), angle: ang + 90, val: 0.2, alpha: 0.95 };",
            "      emit { x: ex, y: ey, size: w, tip: min(1, th / w), angle: ang + 90, val: 0.34 + 0.4 * lit, alpha: 1 };",
            "      emit { x: ex - nx * w * 0.06, y: ey - ny * w * 0.06, size: w * 0.64, tip: min(1, th / (w * 0.64)), angle: ang + 90, val: 0.6 + 0.45 * lit, alpha: 1 };",
            "      emit { x: ex - nx * w * 0.14, y: ey - ny * w * 0.14, size: w * 0.26, tip: min(1, th / (w * 0.26)), angle: ang + 90, val: 1.25, alpha: 0.25 + 0.5 * lit };",
            "    }",
            "  }",
            "}",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/rope-ply.png",
      "tags": [
        "rope",
        "cord",
        "twist",
        "weave"
      ],
      "params": {
        "name": "Rope",
        "spacing": 0.03,
        "buildUp": true,
        "opacity": 1,
        "dynamics": [
          {
            "sensor": "pressure",
            "parameter": "size",
            "outputMin": 0.6,
            "outputMax": 1
          }
        ],
        "program": {
          "state": {
            "ang": 0,
            "sv": 0,
            "ph": 0,
            "pd": 0
          },
          "step": [
            "hide = 1;",
            "if (index == 0) {",
            "  sv = speed;",
            "  emit { size: diameter * 0.68, tip: 1, angle: 0, val: 0.2, alpha: 0.92 };",
            "  emit { size: diameter * 0.68, tip: 1, angle: 45, val: 0.2, alpha: 0.92 };",
            "  emit { size: diameter * 0.6, tip: 1, angle: 0, val: 0.95, alpha: 1 };",
            "  emit { size: diameter * 0.6, tip: 1, angle: 45, val: 0.95, alpha: 1 };",
            "} else {",
            "let gm = max(1, 1.6 / stepPx);",
            "gapMul = gm;",
            "let st = stepPx * gm;",
            "if (index <= 1) { ang = heading; }",
            "else { ang += (mod(heading - ang + 540, 360) - 180) * (1 - exp(-st / (diameter * 0.35))); }",
            "sv += (speed - sv) * 0.2;",
            "let D = diameter;",
            "let w = D * 0.52;",
            "let A = (D - w) * 0.5;",
            "let pitch = D * 1.9;",
            "ph += (dist - pd) / pitch * 360;",
            "pd = dist;",
            "let nx = -sin(ang);",
            "let ny = cos(ang);",
            "let back = cos(ph) < 0 ? 0 : 1;",
            "let th = min(max(st * 2.4, 1.6), D * 0.2);",
            "for q in 0..2 {",
            "  let p = q == 0 ? back : 1 - back;",
            "  let a = ph + p * 180;",
            "  let dk = cos(a);",
            "  let o = A * sin(a);",
            "  let ex = px + nx * o;",
            "  let ey = py + ny * o;",
            "  let lit = 0.5 + 0.5 * dk;",
            "  emit { x: ex, y: ey, size: w * 1.16, tip: min(1, th / (w * 1.16)), angle: ang + 90, val: 0.08, alpha: 0.97 };",
            "  emit { x: ex, y: ey, size: w, tip: min(1, th / w), angle: ang + 90, val: 0.26 + 0.32 * lit, alpha: 1 };",
            "  emit { x: ex - nx * w * 0.08, y: ey - ny * w * 0.08, size: w * 0.66, tip: min(1, th / (w * 0.66)), angle: ang + 90, val: 0.5 + 0.55 * lit, alpha: 1 };",
            "}",
            "let fray = smoothstep(1.2, 4, sv);",
            "if (fray > 0 && rand() < fray * 0.3) {",
            "  let sd = rands() > 0 ? 1 : -1;",
            "  let hl = D * (0.25 + 0.4 * rand());",
            "  let ho = sd * D * (0.38 + 0.1 * rand());",
            "  let hd = ang + 180 - sd * (20 + 25 * rand());",
            "  let rx = px + nx * ho;",
            "  let ry = py + ny * ho;",
            "  emit { x: rx + cos(hd) * hl * 0.5, y: ry + sin(hd) * hl * 0.5, size: hl, tip: max(0.06, 1.1 / hl), angle: hd, val: 0.9, alpha: 0.65 };",
            "}",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/chain-link.png",
      "tags": [
        "chain",
        "link",
        "metal",
        "weave"
      ],
      "params": {
        "name": "Chain",
        "spacing": 0.06,
        "buildUp": true,
        "opacity": 1,
        "dynamics": [
          {
            "sensor": "pressure",
            "parameter": "size",
            "outputMin": 0.6,
            "outputMax": 1
          }
        ],
        "program": {
          "state": {
            "ang": 0,
            "cx": 0,
            "cy": 0,
            "lk": 0
          },
          "step": [
            "hide = 1;",
            "let D = diameter;",
            "let Lo = index == 0 ? D * 0.95 : D * 1.5;",
            "let Wd = index == 0 ? D * 0.95 : D * 0.82;",
            "let t = D * 0.2;",
            "let pitch = D * 0.84;",
            "if (index == 0) { ang = heading; }",
            "else {",
            "  let ca0 = hypot(px - cx, py - cy) > pitch * 0.2 ? atan2(py - cy, px - cx) : heading;",
            "  ang = ca0 + 0.5 * (mod(heading - ca0 + 540, 360) - 180);",
            "}",
            "cx = px;",
            "cy = py;",
            "gapMul = pitch / stepPx;",
            "let ca = cos(ang);",
            "let sa = sin(ang);",
            "if (lk % 2 == 0) {",
            "  let a = Lo * 0.5 - t * 0.5;",
            "  let b = Wd * 0.5 - t * 0.5;",
            "  for i in 0..16 {",
            "    let th = i * 22.5;",
            "    let ex = a * cos(th);",
            "    let ey = b * sin(th);",
            "    emit { x: px + ex * ca - ey * sa + t * 0.1, y: py + ex * sa + ey * ca + t * 0.14, size: t * 1.35, angle: 0, tip: 1, val: 0.1, alpha: 0.6 };",
            "  }",
            "  for i in 0..36 {",
            "    let th = i * 10;",
            "    let ex = a * cos(th);",
            "    let ey = b * sin(th);",
            "    let lx = cos(th) * b;",
            "    let ly = sin(th) * a;",
            "    let ln = hypot(lx, ly);",
            "    let nxs = (lx * ca - ly * sa) / ln;",
            "    let nys = (lx * sa + ly * ca) / ln;",
            "    let lt = -0.55 * nxs - 0.83 * nys;",
            "    emit { x: px + ex * ca - ey * sa, y: py + ex * sa + ey * ca, size: t, angle: 0, tip: 1, val: 0.58 + 0.32 * lt, alpha: 1 };",
            "  }",
            "  for i in 0..48 {",
            "    let th = i * 7.5;",
            "    let ex = a * cos(th);",
            "    let ey = b * sin(th);",
            "    let lx = cos(th) * b;",
            "    let ly = sin(th) * a;",
            "    let ln = hypot(lx, ly);",
            "    let nxs = (lx * ca - ly * sa) / ln;",
            "    let nys = (lx * sa + ly * ca) / ln;",
            "    let lt = -0.55 * nxs - 0.83 * nys;",
            "    emit { x: px + ex * ca - ey * sa - nxs * t * 0.14, y: py + ex * sa + ey * ca - nys * t * 0.14, size: t * 0.5, angle: 0, tip: 1, val: 1.3, alpha: 0.3 + 0.6 * max(lt, 0) };",
            "  }",
            "} else {",
            "  let tb = t * 1.2;",
            "  let h = Lo * 0.5 - tb * 0.5;",
            "  for i in 0..8 {",
            "    let u = i / 7 * 2 - 1;",
            "    emit { x: px + ca * h * u + tb * 0.2, y: py + sa * h * u + tb * 0.3, size: tb * 1.5, angle: 0, tip: 1, val: 0.12, alpha: 0.7 };",
            "  }",
            "  for i in 0..15 {",
            "    let u = i / 14 * 2 - 1;",
            "    emit { x: px + ca * h * u, y: py + sa * h * u, size: tb, angle: 0, tip: 1, val: 0.5, alpha: 1 };",
            "  }",
            "  for i in 0..15 {",
            "    let u = i / 14 * 2 - 1;",
            "    emit { x: px + ca * h * u - tb * 0.08, y: py + sa * h * u - tb * 0.1, size: tb * 0.66, angle: 0, tip: 1, val: 0.78, alpha: 1 };",
            "  }",
            "  for i in 0..30 {",
            "    let u = i / 29 * 2 - 1;",
            "    emit { x: px + ca * h * u - tb * 0.18, y: py + sa * h * u - tb * 0.24, size: tb * 0.3, angle: 0, tip: 1, val: 1.3, alpha: 0.8 };",
            "  }",
            "}",
            "lk += 1;"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/barbed-bar.png",
      "tags": [
        "barbed wire",
        "wire",
        "fence",
        "weave"
      ],
      "params": {
        "name": "Barbed Wire",
        "spacing": 0.03,
        "buildUp": true,
        "opacity": 1,
        "dynamics": [
          {
            "sensor": "pressure",
            "parameter": "size",
            "outputMin": 0.6,
            "outputMax": 1
          }
        ],
        "program": {
          "state": {
            "ang": 0,
            "ph": 0,
            "pd": 0,
            "nb": -1,
            "kx": 0,
            "ky": 0,
            "ka": 0,
            "kd": 0,
            "kt": 0,
            "kp": 0
          },
          "step": [
            "hide = 1;",
            "if (index == 0) {",
            "  emit { size: max(diameter * 0.15, 2), tip: 1, angle: 0, val: 0.1, alpha: 1 };",
            "  emit { size: max(diameter * 0.15, 2), tip: 1, angle: 45, val: 0.1, alpha: 1 };",
            "  emit { size: max(diameter * 0.1, 1.4), tip: 1, angle: 0, val: 0.75, alpha: 1 };",
            "  emit { size: max(diameter * 0.1, 1.4), tip: 1, angle: 45, val: 0.75, alpha: 1 };",
            "} else {",
            "let gm = max(1, 1.0 / stepPx);",
            "gapMul = gm;",
            "let st = stepPx * gm;",
            "if (index <= 1) { ang = heading; }",
            "else { ang += (mod(heading - ang + 540, 360) - 180) * (1 - exp(-st / (diameter * 0.3))); }",
            "let D = diameter;",
            "let tw = max(D * 0.1, 1.3);",
            "let A = tw * 0.6;",
            "let pitch = D * 0.8;",
            "ph += (dist - pd) / pitch * 360;",
            "pd = dist;",
            "let nx = -sin(ang);",
            "let ny = cos(ang);",
            "let th = min(max(st * 2.4, 1.4), D * 0.2);",
            "let back = cos(ph) < 0 ? 0 : 1;",
            "for q in 0..2 {",
            "  let p = q == 0 ? back : 1 - back;",
            "  let a = ph + p * 180;",
            "  let lit = 0.5 + 0.5 * cos(a);",
            "  let o = A * sin(a);",
            "  let ex = px + nx * o;",
            "  let ey = py + ny * o;",
            "  emit { x: ex, y: ey, size: tw * 1.5, tip: min(1, th / (tw * 1.5)), angle: ang + 90, val: 0.06, alpha: 1 };",
            "  emit { x: ex, y: ey, size: tw, tip: min(1, th / tw), angle: ang + 90, val: 0.34 + 0.4 * lit, alpha: 1 };",
            "  emit { x: ex - nx * tw * 0.16, y: ey - ny * tw * 0.16, size: tw * 0.36, tip: min(1, th / (tw * 0.36)), angle: ang + 90, val: 1.2, alpha: 0.35 + 0.55 * lit };",
            "}",
            "let N = D * 2.3;",
            "if (nb < 0) { nb = dist + N * 0.45; }",
            "if (dist >= nb) {",
            "  kx = px;",
            "  ky = py;",
            "  ka = ang + rands() * 10;",
            "  kd = dist;",
            "  kt = 1 - kt;",
            "  kp = 1;",
            "  nb += N;",
            "}",
            "if (kp > 0 && dist - kd >= D * 0.26) {",
            "  kp = 0;",
            "  let Ls = D * (kt == 0 ? 0.5 : 0.42);",
            "  let tb = max(D * 0.12, 1.6);",
            "  let ofs = kt == 0 ? 28 : 56;",
            "  let ths = Ls / 12 * 1.8;",
            "  for pass in 0..2 {",
            "    for s in 0..4 {",
            "      let sg = s < 2 ? 1 : -1;",
            "      let v = s % 2 == 0 ? -1 : 1;",
            "      let da = ka + sg * 90 + v * ofs;",
            "      let cd = cos(da);",
            "      let sd = sin(da);",
            "      let lt = 0.5 - 0.5 * (0.55 * cd + 0.83 * sd);",
            "      for j in 0..12 {",
            "        let u = (j + 0.5) / 12;",
            "        let w0 = tb * pow(1 - u, 0.85) * (pass == 0 ? 1.5 : 1);",
            "        let w = max(w0, 0.9);",
            "        let big = w >= ths;",
            "        let sz = big ? w : ths;",
            "        let tp = big ? ths / w : w / ths;",
            "        let an = big ? da + 90 : da;",
            "        emit { x: kx + cd * Ls * u, y: ky + sd * Ls * u, size: sz, tip: tp, angle: an, val: pass == 0 ? 0.06 : 0.55 + 0.5 * lt, alpha: 1 };",
            "      }",
            "    }",
            "  }",
            "  for s in 0..3 {",
            "    let off = (s - 1) * tw * 0.8;",
            "    let wa = ka + (kt == 0 ? 58 : -58);",
            "    emit { x: kx + cos(ka) * off, y: ky + sin(ka) * off, size: tw * 3.2, tip: tw * 1.7 / (tw * 3.2), angle: wa, val: 0.06, alpha: 1 };",
            "    emit { x: kx + cos(ka) * off, y: ky + sin(ka) * off, size: tw * 3, tip: tw * 1.0 / (tw * 3), angle: wa, val: 0.95, alpha: 1 };",
            "  }",
            "}",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/ribbon-band.png",
      "tags": [
        "ribbon",
        "band",
        "twist",
        "weave"
      ],
      "params": {
        "name": "Ribbon",
        "spacing": 0.035,
        "buildUp": true,
        "opacity": 1,
        "dynamics": [
          {
            "sensor": "pressure",
            "parameter": "size",
            "outputMin": 0.55,
            "outputMax": 1
          }
        ],
        "program": {
          "state": {
            "ang": 0,
            "tw": 0,
            "sv": 0
          },
          "step": [
            "hide = 1;",
            "let D = diameter;",
            "if (index == 0) {",
            "  sv = speed;",
            "  emit { size: D * 0.3, tip: 1, angle: 0, val: 0.55, alpha: 1 };",
            "  emit { size: D * 0.3, tip: 1, angle: 45, val: 0.55, alpha: 1 };",
            "} else {",
            "  let gm = max(1, 1.5 / stepPx);",
            "  gapMul = gm;",
            "  let st = stepPx * gm;",
            "  let dA = 0;",
            "  if (index == 1) { ang = heading; }",
            "  else {",
            "    dA = (mod(heading - ang + 540, 360) - 180) * (1 - exp(-st / (D * 0.4)));",
            "    ang += dA;",
            "  }",
            "  sv += (speed - sv) * 0.12;",
            "  let base = st / (D * 3.4) * 180;",
            "  tw += base * (1 + 0.9 * smoothstep(0.5, 3.5, sv)) + abs(dA) * 1.6;",
            "  let c = cos(tw);",
            "  let face = c >= 0;",
            "  let ac = abs(c);",
            "  let Wb = D * ac;",
            "  let thick = max(st * 2.4, 2);",
            "  let sz = max(Wb, thick);",
            "  let glint = 1 - smoothstep(0, 0.28, ac);",
            "  let lt = (face ? 0.6 + 0.2 * c : 0.22 + 0.2 * ac) + 0.85 * glint;",
            "  emit { x: px, y: py, size: sz, tip: min(1, thick / sz), angle: ang + 90, val: lt, alpha: 1 };",
            "  emit { x: px, y: py, size: sz * 0.6, tip: min(1, thick / (sz * 0.6)), angle: ang + 90, val: lt + 0.1, alpha: 0.7 };",
            "  let nx = -sin(ang);",
            "  let ny = cos(ang);",
            "  let e = max(1.3, D * 0.05);",
            "  if (Wb > e * 2) {",
            "    for s in 0..2 {",
            "      let sg = s * 2 - 1;",
            "      emit { x: px + nx * sg * (Wb * 0.5 - e * 0.5), y: py + ny * sg * (Wb * 0.5 - e * 0.5), size: thick, tip: e / thick, angle: ang, val: face ? 1.35 : 0.6, alpha: 1 };",
            "    }",
            "  }",
            "}"
          ]
        }
      }
    }
  ]
}