{
  "azphalt": "0.1",
  "id": "com.hereliesaz.azphalt.kinetic.wild-growth",
  "name": "Wild Growth Kinetic",
  "version": "1.0.0",
  "kind": "asset",
  "license": "LicenseRef-Proprietary",
  "compat": ">=0.1",
  "description": "Nature that grows under the pen: a stem that puts out leaves in a spiral and closes in a bud when you let go, grass combed the way you dragged it, bark that splits along your line, clouds that billow wherever you wait, and rain slanted by your hand that splashes where it lands.",
  "author": "HereLiesAz",
  "targetApps": [
    "com.hereliesaz.graffux"
  ],
  "preview": {
    "image": "assets/preview.png"
  },
  "assets": [
    {
      "type": "brush",
      "path": "assets/leaf.png",
      "tags": [
        "leaves",
        "foliage",
        "vine"
      ],
      "params": {
        "name": "Leaf Scatter",
        "spacing": 0.3,
        "opacity": 1,
        "program": {
          "state": {
            "lx": 0,
            "ly": 0,
            "nextLeaf": 0,
            "n": 0
          },
          "step": [
            "hide = 1;",
            "let d = diameter;",
            "let pr = 0.55 + 0.45 * clamp(pressure, 0, 1);",
            "if (index == 0) { lx = px; ly = py; nextLeaf = 0.35 * d; n = 0; }",
            "// the stem: one sliver from the last point to this one",
            "let sx = px - lx;",
            "let sy = py - ly;",
            "let sl = hypot(sx, sy);",
            "let sw = max(0.075 * d * pr, 0.9);",
            "if (sl > 0.01) {",
            "  let slen = sl + sw * 1.5;",
            "  emit { x: (px + lx) * 0.5, y: (py + ly) * 0.5, size: slen, tip: clamp(sw / slen, 0.05, 1), angle: atan2(sy, sx), alpha: 1, val: 0.8 };",
            "}",
            "lx = px;",
            "ly = py;",
            "// a rosette at the base, as big and as full as the touchdown was long",
            "if (index == 0) {",
            "  let dw = clamp(dwell / 700, 0, 1);",
            "  let rn = 3 + floor(4 * dw);",
            "  for k in 0..7 {",
            "    if (k < rn) {",
            "      let a = heading + 180 + k * 137.508;",
            "      let L = d * pr * (0.75 + 0.5 * dw) * (0.8 + 0.3 * hash(k * 2.3 + 900));",
            "      emit { x: px + cos(a) * L * 0.55, y: py + sin(a) * L * 0.55, size: L, tip: 0.4, angle: a, alpha: 1, val: 0.62 + 0.25 * hash(k * 4.1 + 900) };",
            "      emit { x: px + cos(a) * L * 0.52, y: py + sin(a) * L * 0.52, size: L * 0.82, tip: 0.05, angle: a, alpha: 0.9, val: 0.4 };",
            "    }",
            "  }",
            "}",
            "// nodes: alternate sides, spiral splay; internodes stretch when the hand hurries",
            "let inter = d * (0.5 + 0.55 * clamp(layerSpeed / 1.6, 0, 1));",
            "for k in 0..4 {",
            "  if (phase != 3 && dist >= nextLeaf) {",
            "    let side = (mod(n, 2) < 0.5) ? 1 : -1;",
            "    let g = n * 137.508;",
            "    let spread = 44 + 14 * sin(g) + (hash(n + 7) - 0.5) * 12;",
            "    let L = d * pr * (0.85 + 0.3 * hash(n * 3.1)) * (1 - 0.22 * abs(cos(g)));",
            "    let back = dist - nextLeaf;",
            "    let nx = px - cos(heading) * back;",
            "    let ny = py - sin(heading) * back;",
            "    let a = heading + side * spread;",
            "    let cx = nx + cos(a) * L * 0.56;",
            "    let cy = ny + sin(a) * L * 0.56;",
            "    emit { x: cx, y: cy, size: L, tip: 0.4, angle: a, alpha: 1, val: 0.74 + 0.26 * hash(n * 5.7) };",
            "    emit { x: cx - cos(a) * L * 0.03, y: cy - sin(a) * L * 0.03, size: L * 0.82, tip: 0.05, angle: a, alpha: 0.9, val: 0.45 };",
            "    n += 1;",
            "    nextLeaf += inter * (0.85 + 0.3 * hash(n * 1.3));",
            "  }",
            "}",
            "// lift-off: the growing tip closes in a bud of young leaves",
            "if (phase == 3 && index > 0) {",
            "  let L = d * pr * 0.5;",
            "  for k in 0..3 {",
            "    let a = heading + (k - 1) * 28;",
            "    let Lk = L * (k == 1 ? 0.85 : 0.65);",
            "    emit { x: px + cos(a) * Lk * 0.5, y: py + sin(a) * Lk * 0.5, size: Lk, tip: (k == 1 ? 0.3 : 0.4), angle: a, alpha: 1, val: 0.9 };",
            "  }",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/blade.png",
      "tags": [
        "grass",
        "foliage",
        "ground"
      ],
      "params": {
        "name": "Grass Tufts",
        "spacing": 0.3,
        "opacity": 1,
        "program": {
          "state": {
            "tall": 1,
            "wind": 0
          },
          "step": [
            "hide = 1;",
            "let d = diameter;",
            "if (index == 0) { tall = 1 + 1.1 * clamp(dwell / 700, 0, 1); wind = 0; }",
            "if (phase != 3) {",
            "  let pr = 0.45 + 0.55 * clamp(pressure, 0, 1);",
            "  let linger = clamp((dt / max(stepPx, 0.01)) / 30, 0, 1);",
            "  let targ = clamp(cos(heading) * layerSpeed * 26, -34, 34);",
            "  wind = lerp(wind, targ, 0.2);",
            "  let H = d * 1.8 * pr * tall * (1 + 0.45 * linger);",
            "  for k in 0..4 {",
            "    let s = index * 4 + k;",
            "    let u = hash(s * 1.7);",
            "    let bx = px - cos(heading) * stepPx * u + (hash(s * 2.3) - 0.5) * 0.4 * d;",
            "    let by = py - sin(heading) * stepPx * u + (hash(s * 4.1) - 0.5) * 0.18 * d;",
            "    let len = H * (0.4 + 0.6 * hash(s * 3.3));",
            "    let a = -90 + wind * (0.6 + 0.8 * hash(s * 8.3)) + (hash(s * 5.9) - 0.5) * 30;",
            "    let w = max(0.075 * d * (0.7 + 0.6 * hash(s * 6.1)), 1.0);",
            "    emit { x: bx + cos(a) * len * 0.5, y: by + sin(a) * len * 0.5, size: len, tip: clamp(w / len, 0.05, 1), angle: a, alpha: 1, val: 0.5 + 0.5 * hash(s * 7.7) };",
            "  }",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/bark-fibre.png",
      "tags": [
        "bark",
        "wood",
        "texture"
      ],
      "params": {
        "name": "Streaked Bark",
        "spacing": 0.14,
        "opacity": 1,
        "program": {
          "state": {},
          "step": [
            "hide = 1;",
            "if (phase != 3) {",
            "  let W = diameter * (0.45 + 0.55 * clamp(pressure, 0, 1));",
            "  let ramp = 0.35 + 0.65 * smoothstep(0, 0.6 * W, dist);",
            "  let nxp = -sin(heading);",
            "  let nyp = cos(heading);",
            "  let len = max(stepPx * 2.6, 0.22 * W);",
            "  let f0 = dist / W;",
            "  let calm = clamp(layerSpeed / 2.5, 0, 0.6);",
            "  for l in 0..7 {",
            "    let u = ((l + 0.5) / 7 - 0.5 + (noise(f0 * 0.3 + l * 7.31) - 0.5) * 0.08) * ramp;",
            "    let h = 0.5 / 7 * (0.72 + 0.45 * noise(f0 * 0.7 + l * 3.17 + 40)) * ramp;",
            "    let fk = smoothstep(0.6 + 0.2 * calm, 0.82, noise(f0 * 0.22 + l * 11.3 + 90));",
            "    let v = 0.6 + 0.4 * noise(f0 * 0.45 + l * 5.3 + 20);",
            "    let al = gate(0.1, noise(f0 * 1.4 + l * 2.9 + 130));",
            "    for s in 0..2 {",
            "      let sg = s * 2 - 1;",
            "      let on = (fk > 0.04) ? 1 : (s == 0 ? 1 : 0);",
            "      if (on > 0) {",
            "        let uu = u + sg * fk * h * 0.6;",
            "        let hh = h * (1 - 0.55 * fk);",
            "        emit { x: px + nxp * uu * W, y: py + nyp * uu * W, size: len, tip: clamp(2 * hh * W / len, 0.05, 1), angle: heading, alpha: al, val: v - 0.12 * fk };",
            "      }",
            "    }",
            "  }",
            "}"
          ]
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/puff.png",
      "tags": [
        "clouds",
        "sky",
        "soft"
      ],
      "params": {
        "name": "Cloud Puff",
        "spacing": 0.3,
        "opacity": 1,
        "buildUp": true,
        "program": {
          "state": {
            "held": 0,
            "n": 0
          },
          "step": [
            "hide = 1;",
            "let d = diameter;",
            "let pr = 0.4 + 0.6 * clamp(pressure, 0, 1);",
            "if (phase == 0) { held = min(dwell, 1500); }",
            "if (phase == 2) { held = min(held + dt, 5000); }",
            "if (phase == 1) { held = held * exp(-stepPx / (d * 2.5)); }",
            "let g = sqrt(held / 1000);",
            "let R = d * (0.5 + 0.55 * g);",
            "if (phase != 3) {",
            "  let cnt = (phase == 2) ? 2 : 3 + floor(2 * clamp(layerSpeed, 0, 1));",
            "  let aa = (phase == 2) ? 0.6 : 1;",
            "  for k in 0..5 {",
            "    if (k < cnt) {",
            "      let s = n;",
            "      n += 1;",
            "      let a = -90 + (hash(s * 1.37) - 0.5) * 230;",
            "      let r = R * sqrt(hash(s * 2.71));",
            "      let ox = cos(a) * r * 1.3;",
            "      let oy = min(sin(a) * r, 0.15 * R);",
            "      let sz = d * pr * (0.75 + 0.5 * hash(s * 3.9)) * (1 + 0.5 * g) * (1 - 0.3 * r / max(R, 0.01));",
            "      let top = clamp(0.5 - oy / max(R, 0.01) * 0.6, 0, 1);",
            "      emit { x: px + ox, y: py + oy + sz * 0.14, size: sz, alpha: 0.26 * aa, val: 0.55, angle: hash(s * 5.1) * 360 };",
            "      emit { x: px + ox - sz * 0.05, y: py + oy - sz * 0.1, size: sz * 0.76, alpha: 0.3 * aa, val: 0.8 + 0.25 * top, angle: hash(s * 6.3) * 360 };",
            "    }",
            "  }",
            "}"
          ],
          "tickMs": 40
        }
      }
    },
    {
      "type": "brush",
      "path": "assets/rain-streak.png",
      "tags": [
        "rain",
        "weather",
        "streaks"
      ],
      "params": {
        "name": "Slant Rain",
        "spacing": 0.5,
        "opacity": 1,
        "program": {
          "state": {
            "wind": 0,
            "maxY": 0,
            "minX": 0,
            "maxX": 0
          },
          "step": [
            "hide = 1;",
            "let d = diameter;",
            "if (index == 0) { wind = 0; maxY = py; minX = px; maxX = px; }",
            "let tw = clamp(cos(heading) * layerSpeed * 16, -40, 40);",
            "wind = lerp(wind, tw, 0.2);",
            "let sp = clamp(layerSpeed / 2.2, 0, 1);",
            "let L = d * (0.9 + 2.8 * sp);",
            "let ang = 90 - wind;",
            "let dx = cos(ang);",
            "let dy = sin(ang);",
            "if (phase != 3) {",
            "  let k = 3 + floor(2.5 * clamp(pressure, 0, 1));",
            "  for i in 0..5 {",
            "    if (i < k) {",
            "      let s = index * 5 + i;",
            "      let cx = px + (hash(s * 1.3) - 0.5) * 3.2 * d;",
            "      let cy = py + (hash(s * 2.9) - 0.5) * 2.2 * d;",
            "      let ll = L * (0.55 + 0.65 * hash(s * 4.7));",
            "      emit { x: cx, y: cy, size: ll, tip: clamp(4 * max(0.035 * d, 0.9) / ll, 0.05, 1), angle: ang, alpha: 0.4 + 0.55 * hash(s * 6.1) };",
            "      let ex = cx + dx * ll * 0.5;",
            "      let ey = cy + dy * ll * 0.5;",
            "      spray(ex, ey, 1.2 * d, 8);",
            "      // the lowest drops hit something: a splash, fatter where the ground is already wet",
            "      if (ey > py + 0.75 * d && hash(s * 8.9) < 0.45) {",
            "        let q = clamp(wetAt(ex, ey, 1.2 * d) / 35, 0.35, 1.4);",
            "        emit { x: ex, y: ey + 0.1 * d, size: d * 0.8 * q, tip: 0.5, angle: 0, alpha: 0.6 };",
            "        for t in 0..2 {",
            "          let sa = -90 + (t * 2 - 1) * (35 + 20 * hash(s * 3.1 + t));",
            "          emit { x: ex + cos(sa) * d * 0.35 * q, y: ey + sin(sa) * d * 0.35 * q, size: d * 0.22 * q, tip: 1, angle: sa, alpha: 0.75 };",
            "        }",
            "      }",
            "      maxY = max(maxY, ey);",
            "      minX = min(minX, ex);",
            "      maxX = max(maxX, ex);",
            "    }",
            "  }",
            "}",
            "// lift-off: what fell lands, and splashes where the ground got wettest",
            "if (phase == 3) {",
            "  let span = maxX - minX;",
            "  let m = clamp(floor(span / (1.0 * d)), 1, 40);",
            "  let gy = maxY + 0.25 * d;",
            "  for j in 0..40 {",
            "    if (j < m) {",
            "      let x = minX + span * (j + hash(j * 3.3 + 500)) / m;",
            "      let w = wetAt(x, maxY - 0.8 * d, 1.8 * d);",
            "      let q = clamp(w / 30, 0.25, 1.5) * (0.65 + 0.5 * hash(j * 9.1 + 77));",
            "      if (hash(j * 7.7 + 300) < 0.85) {",
            "        emit { x: x, y: gy, size: d * 1.2 * q, tip: 0.6, angle: 0, alpha: 0.75 };",
            "        for t in 0..3 {",
            "          let aa = -90 + (t - 1) * 48 + (hash(j * 13 + t) - 0.5) * 18;",
            "          let rr = d * 0.5 * q;",
            "          emit { x: x + cos(aa) * rr, y: gy - 0.05 * d + sin(aa) * rr, size: d * 0.35 * q, tip: 1, angle: aa, alpha: 0.8 };",
            "        }",
            "      }",
            "    }",
            "  }",
            "}"
          ]
        }
      }
    }
  ]
}
